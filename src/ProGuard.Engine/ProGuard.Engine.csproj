<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-ProGuard.Engine-12345</UserSecretsId>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <PackageReference Include="System.Management" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProGuard.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ProGuard.Core\ProGuard.Core.csproj" />
    <ProjectReference Include="..\ProGuard.Shared\ProGuard.Shared.csproj" />
    <!-- Not used by the engine's code: built and published next to it, for SessionAgentSupervisor to start. -->
    <ProjectReference Include="..\ProGuard.SessionAgent\ProGuard.SessionAgent.csproj" />
  </ItemGroup>
</Project>
