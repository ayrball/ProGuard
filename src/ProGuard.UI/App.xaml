<Application x:Class="ProGuard.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ProGuard.UI.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Volt.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:VisibleWhen x:Key="VisibleWhen"/>
            <conv:EqualsParameter x:Key="EqualsParameter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
