<ui:FluentWindow x:Class="ProGuard.UI.Controls.AffinityPickerDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Set CPU Affinity" Height="640" Width="520"
                 WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
                 UseLayoutRounding="True" SnapsToDevicePixels="True"
                 TextOptions.TextFormattingMode="Display"
                 TextOptions.TextRenderingMode="ClearType"
                 RenderOptions.ClearTypeHint="Enabled">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Info -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="CPU Affinity &amp; SMT Configuration" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock x:Name="ProcessNameText" Text="Configure process affinity" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
            <TextBlock x:Name="CpuNameText" Text="Processor: ..." Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- SMT Controls Card -->
        <ui:CardControl Grid.Row="1" Margin="0,0,0,16" Padding="12">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Disable SMT (Physical Cores Only)" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="Runs process solely on physical cores to minimize latency and cache jitter." 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" x:Name="SmtToggle" VerticalAlignment="Center" 
                                     Checked="SmtToggle_Checked" Unchecked="SmtToggle_Unchecked"/>
                </Grid>

                <WrapPanel Orientation="Horizontal">
                    <ui:Button Content="Physical Cores Only (No SMT)" Margin="0,0,8,6" Click="PhysicalOnly_Click" Appearance="Secondary"/>
                    <ui:Button Content="All Cores (SMT On)" Margin="0,0,8,6" Click="SelectAll_Click"/>
                    <ui:Button Content="SMT Siblings Only" Margin="0,0,8,6" Click="SmtSiblingsOnly_Click"/>
                    <ui:Button Content="Clear All" Margin="0,0,0,6" Click="ClearAll_Click"/>
                </WrapPanel>
            </StackPanel>
        </ui:CardControl>

        <!-- Cores List -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" Padding="8" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CoresList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4" Padding="10,8" CornerRadius="6" 
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                              Content="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>

                                    <Border Grid.Column="2" Padding="6,2" CornerRadius="4" 
                                            Background="{Binding BadgeBackground}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CoreTypeTag}" FontSize="11" 
                                                   Foreground="{Binding BadgeForeground}" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Summary Bar -->
        <Border Grid.Row="3" Background="{DynamicResource ControlFillColorSecondaryBrush}" 
                Padding="12,8" CornerRadius="6" Margin="0,0,0,16">
            <TextBlock x:Name="SummaryText" Text="Selected: 0/0 Cores | Mask: 0x0 | SMT: ..." 
                       FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Border>

        <!-- Dialog Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="Cancel" Margin="0,0,12,0" Width="90" Click="CancelButton_Click"/>
            <ui:Button Content="Apply" Appearance="Primary" Width="100" Click="ApplyButton_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
