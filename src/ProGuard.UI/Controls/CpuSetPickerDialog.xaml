<ui:FluentWindow x:Class="ProGuard.UI.Controls.CpuSetPickerDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Choose CPU Sets" Height="600" Width="560"
                 WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
                 UseLayoutRounding="True" SnapsToDevicePixels="True"
                 TextOptions.TextFormattingMode="Display">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="CPU Sets" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock x:Name="ProcessNameText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" TextWrapping="Wrap"
                       Text="A soft preference the scheduler honours when it can, unlike affinity. IDs come from GetSystemCpuSetInformation."/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <ui:Button Content="All" Margin="0,0,8,6" Click="SelectAll_Click"/>
            <ui:Button x:Name="FastestButton" Content="Fastest class (P-cores)" Margin="0,0,8,6" Click="SelectFastest_Click"/>
            <ui:Button x:Name="SlowestButton" Content="Slowest class (E-cores)" Margin="0,0,8,6" Click="SelectSlowest_Click"/>
            <ui:Button Content="Clear" Margin="0,0,0,6" Click="ClearAll_Click"/>
        </WrapPanel>

        <Border Grid.Row="2" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6"
                Background="{DynamicResource ControlFillColorDefaultBrush}" Padding="8" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CpuSetList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2" Padding="10,6" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Name}"
                                              FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Location}" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding ClassTag}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource ControlFillColorSecondaryBrush}" Padding="12,8" CornerRadius="6" Margin="0,0,0,16">
            <TextBlock x:Name="SummaryText" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="Cancel" Margin="0,0,12,0" Width="90" Click="CancelButton_Click"/>
            <ui:Button Content="OK" Appearance="Primary" Width="100" Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
