<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    
    <ContextMenu x:Key="ProcessContextMenu">
        <MenuItem Header="Set Priority">
            <MenuItem Header="Realtime"/>
            <MenuItem Header="High"/>
            <MenuItem Header="Above Normal"/>
            <MenuItem Header="Normal"/>
            <MenuItem Header="Below Normal"/>
            <MenuItem Header="Idle"/>
        </MenuItem>
        <MenuItem Header="Set CPU Affinity..."/>
        <MenuItem Header="Set CPU Limit..."/>
        <MenuItem Header="Create Persistent Rule"/>
        <Separator/>
        <MenuItem Header="Terminate Process"/>
        <MenuItem Header="Suspend"/>
        <MenuItem Header="Resume"/>
        <MenuItem Header="Open File Location"/>
        <Separator/>
        <MenuItem Header="Disallow Process"/>
    </ContextMenu>

</ResourceDictionary>
