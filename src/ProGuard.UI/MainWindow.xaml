<ui:FluentWindow x:Class="ProGuard.UI.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:ProGuard.UI.Views"
                 Title="ProGuard" Height="750" Width="1100"
                 WindowStartupLocation="CenterScreen"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 TextOptions.TextFormattingMode="Display"
                 TextOptions.TextRenderingMode="ClearType"
                 RenderOptions.ClearTypeHint="Enabled">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Window Bar: Navigation Controls + Fluent TitleBar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Convenient Navigation Controls in Top Bar: Back button and Three-line Hamburger icon -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,4,0">
                <!-- Back Button -->
                <ui:Button x:Name="BackButton" Appearance="Transparent" Padding="7,6" Margin="0,0,4,0"
                           Click="OnBackButtonClicked" ToolTip="Go Back (Previous Page)">
                    <ui:SymbolIcon Symbol="ArrowLeft20" FontSize="15" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </ui:Button>

                <!-- 3-Line Hamburger Pane Toggle Button -->
                <ui:Button x:Name="PaneToggleButton" Appearance="Transparent" Padding="7,6" Margin="0,0,8,0"
                           Click="OnPaneToggleButtonClicked" ToolTip="Toggle Navigation Sidebar (Expand / Collapse)">
                    <ui:SymbolIcon Symbol="Navigation20" FontSize="15" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </ui:Button>
            </StackPanel>

            <ui:TitleBar Grid.Column="1" Title="ProGuard" Padding="6,0,0,0">
                <ui:TitleBar.Icon>
                    <ui:SymbolIcon Symbol="ShieldCheckmark24"/>
                </ui:TitleBar.Icon>
            </ui:TitleBar>
        </Grid>

        <Grid Grid.Row="1">
            <ui:NavigationView x:Name="RootNavigation" 
                               ItemInvoked="RootNavigation_ItemInvoked"
                               IsBackButtonVisible="Collapsed"
                               IsPaneToggleVisible="False"
                               Transition="None"
                               TransitionDuration="0"
                               OpenPaneLength="200"
                               CompactPaneLength="48">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="Dashboard" TargetPageType="{x:Type views:DashboardPage}" Icon="{ui:SymbolIcon Symbol=Home24}"/>
                    <ui:NavigationViewItem Content="Processes" TargetPageType="{x:Type views:ProcessListPage}" Icon="{ui:SymbolIcon Symbol=AppsList24}"/>
                    <ui:NavigationViewItem Content="Rules" TargetPageType="{x:Type views:RulesPage}" Icon="{ui:SymbolIcon Symbol=Book24}"/>
                    <ui:NavigationViewItem Content="Watchdog" TargetPageType="{x:Type views:WatchdogPage}" Icon="{ui:SymbolIcon Symbol=Eye24}"/>
                    <ui:NavigationViewItem Content="Power" TargetPageType="{x:Type views:PowerPage}" Icon="{ui:SymbolIcon Symbol=BatteryCharge24}"/>
                    <ui:NavigationViewItem Content="Logs" TargetPageType="{x:Type views:LogsPage}" Icon="{ui:SymbolIcon Symbol=DocumentText24}"/>
                </ui:NavigationView.MenuItems>

                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem Content="Settings" TargetPageType="{x:Type views:SettingsPage}" Icon="{ui:SymbolIcon Symbol=Settings24}"/>
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>
            <ui:SnackbarPresenter x:Name="SnackbarPresenter" VerticalAlignment="Bottom"/>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource ControlFillColorDefaultBrush}" 
                Padding="16,8" BorderThickness="0,1,0,0" MinHeight="36"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{Binding EngineStatusColor}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding EngineStatusText}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="DataHistogram24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding GlobalCpuText}" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding GlobalRamText}" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>
                
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Flash24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                    <TextBlock Text="{Binding ProBalanceStatus}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
