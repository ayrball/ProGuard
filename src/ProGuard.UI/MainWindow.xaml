<Window x:Class="ProGuard.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:r="clr-namespace:ProGuard.UI.Resources"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProGuard.UI.ViewModels"
        xmlns:views="clr-namespace:ProGuard.UI.Views"
        Title="ProGuard" Width="1360" Height="860" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource InkBrush}" Foreground="{StaticResource VoltBrush}"
        FontFamily="{StaticResource Display}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Pages -->
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><views:OverviewView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProcessesViewModel}"><views:ProcessesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RulesViewModel}"><views:RulesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WatchdogViewModel}"><views:WatchdogView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityViewModel}"><views:ActivityView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemViewModel}"><views:SystemView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AdvancedViewModel}"><views:AdvancedView/></DataTemplate>
        <!-- Dialogs -->
        <DataTemplate DataType="{x:Type vm:ConfirmDialogViewModel}"><views:ConfirmDialog/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AffinityDialogViewModel}"><views:AffinityDialog/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CpuLimitDialogViewModel}"><views:CpuLimitDialog/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CpuSetDialogViewModel}"><views:CpuSetDialog/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfileNameDialogViewModel}"><views:ProfileNameDialog/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfigPreviewDialogViewModel}"><views:ConfigPreviewDialog/></DataTemplate>
    </Window.Resources>

    <Border x:Name="Frame" BorderBrush="{StaticResource VoltLineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <!-- ============================================================ top bar (draggable caption) -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Wordmark: a solid volt block, the one big flood of colour that frames everything else. -->
                <Border Background="{StaticResource VoltBrush}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                        <TextBlock Text="{x:Static r:Strings.Proguard}" Foreground="{StaticResource InkBrush}" FontWeight="Bold" FontStretch="Condensed" FontSize="34"
                                   VerticalAlignment="Center"/>
                        <Rectangle Width="10" Height="10" Fill="{StaticResource InkBrush}" Margin="8,14,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="30,0,0,0">
                    <TextBlock Text="{Binding CurrentPage.Number}" FontFamily="{StaticResource Mono}" FontSize="13" Opacity="0.5" VerticalAlignment="Center"/>
                    <TextBlock Text="/" FontFamily="{StaticResource Mono}" FontSize="13" Opacity="0.3" Margin="8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentPage.Title}" FontWeight="Bold" FontStretch="SemiCondensed" FontSize="15" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Clock}" FontFamily="{StaticResource Mono}" FontSize="13" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,22,0"
                               Height="34" Padding="0,9,0,0"/>
                    <Button Style="{StaticResource Btn.Chrome}" Content="&#xE921;" Click="OnMinimize" ToolTip="{x:Static r:Strings.Minimise}" AutomationProperties.Name="Minimise"/>
                    <Button x:Name="MaxButton" Style="{StaticResource Btn.Chrome}" Content="&#xE922;" Click="OnMaximize" ToolTip="{x:Static r:Strings.Maximise}" AutomationProperties.Name="Maximise"/>
                    <Button Style="{StaticResource Btn.Chrome}" Content="&#xE8BB;" Click="OnClose" ToolTip="{x:Static r:Strings.Close}" AutomationProperties.Name="Close"/>
                </StackPanel>
            </Grid>

            <!-- A heavy rule under the bar. -->
            <Rectangle Grid.Row="1" Fill="{StaticResource VoltBrush}"/>

            <!-- ============================================================ rail + page -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border BorderBrush="{StaticResource VoltLineBrush}" BorderThickness="0,0,2,0">
                    <DockPanel>
                        <!-- Engine state block at the foot of the rail. -->
                        <Border DockPanel.Dock="Bottom" Margin="20" Padding="16,14" BorderThickness="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource VoltBrush}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource VoltBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Hub.IsOffline}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource VoltBrush}"/>
                                            <Setter Property="TextElement.Foreground" Value="{StaticResource InkBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{x:Static r:Strings.Engine}" Style="{StaticResource Text.Label}"/>
                                <TextBlock FontWeight="Bold" FontStretch="Condensed" FontSize="30" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{x:Static r:Strings.Online}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Hub.IsOffline}" Value="True">
                                                    <Setter Property="Text" Value="{x:Static r:Strings.Offline}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Hub.Snapshot.Processes.Count, StringFormat={x:Static r:Strings.N0ProcessesWatched}}" FontFamily="{StaticResource Mono}"
                                           FontSize="10.5" Opacity="0.6" Margin="0,4,0,0"
                                           Visibility="{Binding Hub.IsOnline, Converter={StaticResource VisibleWhen}}"/>
                                <!-- Standard rights: the engine refuses what only an administrator may do. Hidden while
                                     offline, when the card turns volt and an outline button would vanish into it. -->
                                <ContentControl Focusable="False" Visibility="{Binding Hub.IsOnline, Converter={StaticResource VisibleWhen}}">
                                    <Button Style="{StaticResource Btn.Outline}" Content="{x:Static r:Strings.RestartAsAdmin}" Command="{Binding RestartElevatedCommand}"
                                            AutomationProperties.Name="Restart as administrator" FontSize="11.5" Padding="10,7" Margin="0,12,0,0"
                                            HorizontalAlignment="Left" ToolTip="{x:Static r:Strings.OpenProguardAgainWithAdministratorRights}"
                                            Visibility="{Binding CanRestartElevated, Converter={StaticResource VisibleWhen}}"/>
                                </ContentControl>
                            </StackPanel>
                        </Border>

                        <ListBox Style="{StaticResource Rail}" AutomationProperties.AutomationId="Pages" ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage}" Margin="0,18,0,0"/>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1">
                    <ContentControl Content="{Binding CurrentPage.Page}" Margin="40,30,40,24" Focusable="False"/>

                    <!-- Offline state: takes over the page area until the engine answers. -->
                    <Grid Background="{StaticResource InkBrush}" Visibility="{Binding Hub.IsOffline, Converter={StaticResource VisibleWhen}}">
                        <StackPanel VerticalAlignment="Center" Margin="56,0">
                            <TextBlock Text="{x:Static r:Strings.NoSignal}" Style="{StaticResource Text.Label}" FontSize="14"/>
                            <!-- BlockLineHeight: the 130 px lines start below the kicker instead of reaching up into it. -->
                            <TextBlock Text="{x:Static r:Strings.EngineOffline}" Style="{StaticResource Text.Hero}" FontSize="150" LineHeight="130"
                                       LineStackingStrategy="BlockLineHeight" Margin="0,18,0,0"/>
                            <Rectangle Height="6" Fill="{StaticResource VoltBrush}" Width="220" HorizontalAlignment="Left" Margin="0,26,0,24"/>
                            <TextBlock Style="{StaticResource Text.Body}" FontSize="17" MaxWidth="620" HorizontalAlignment="Left" Opacity="0.8"
                                       Text="{x:Static r:Strings.ProguardsEngineDoesTheActualWork}"/>
                            <TextBlock Text="{x:Static r:Strings.RetryingEvery2Seconds}" FontFamily="{StaticResource Mono}" FontSize="11.5" Opacity="0.5" Margin="0,22,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Toasts -->
                    <!-- Bottom left, over the lists: bottom right covered the editors' Save and Cancel buttons, top right
                         the pages' NEW buttons. -->
                    <ItemsControl AutomationProperties.AutomationId="Toasts" ItemsSource="{Binding Toaster.Items}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="28,0,0,22" Width="380">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,8,0,0" Padding="16,12" BorderThickness="2" BorderBrush="{StaticResource VoltBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource InkBrush}"/>
                                            <Setter Property="TextElement.Foreground" Value="{StaticResource VoltBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource VoltBrush}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource InkBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontWeight="Bold" FontSize="18" Margin="0,-2,12,0" VerticalAlignment="Top">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="■"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Text" Value="!"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="13.5"/>
                                            <Button Content="{Binding ActionText}" Command="{Binding Action}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                                    Padding="10,6" FontSize="11.5" BorderThickness="2" Background="Transparent" Cursor="Hand"
                                                    Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                                                    BorderBrush="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"
                                                    Visibility="{Binding Action, Converter={StaticResource VisibleWhen}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                                            <TextBlock Text="{TemplateBinding Content}" FontWeight="Bold" FontSize="{TemplateBinding FontSize}"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>

            <!-- ============================================================ status strip -->
            <Border Grid.Row="3" BorderBrush="{StaticResource VoltLineBrush}" BorderThickness="0,2,0,0">
                <Grid Margin="24,0">
                    <TextBlock Text="{Binding StatusLine}" FontFamily="{StaticResource Mono}" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource Mono}" FontSize="11" Opacity="0.6"
                                   Text="{Binding Hub.Snapshot.CpuPercent, StringFormat={x:Static r:Strings.Cpu00}}"/>
                        <TextBlock FontFamily="{StaticResource Mono}" FontSize="11" Opacity="0.3" Text="  ·  "/>
                        <TextBlock FontFamily="{StaticResource Mono}" FontSize="11" Opacity="0.6"
                                   Text="{Binding Hub.Snapshot.MemoryPercent, StringFormat={x:Static r:Strings.Mem00}}"/>
                        <TextBlock FontFamily="{StaticResource Mono}" FontSize="11" Opacity="0.3" Text="  ·  "/>
                        <TextBlock FontFamily="{StaticResource Mono}" FontSize="11" Opacity="0.6"
                                   Text="{Binding Hub.Snapshot.ProBalanceRestrained, StringFormat={x:Static r:Strings.N0Balanced}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================ modal layer -->
            <Grid Grid.RowSpan="4" Background="{StaticResource InkVeilBrush}"
                  Visibility="{Binding Dialog, Converter={StaticResource VisibleWhen}}">
                <Border Background="{StaticResource InkBrush}" BorderBrush="{StaticResource VoltBrush}" BorderThickness="3"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="520" MaxWidth="760" Padding="40,34">
                    <ContentControl Content="{Binding Dialog}" Focusable="False"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
