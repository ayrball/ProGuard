<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon). Everything else is WPF, so WinForms' implicit usings are removed below:
         they would make Application, Button, Brushes, MessageBox... ambiguous. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ProGuard.UI</RootNamespace>
    <AssemblyName>ProGuard.UI</AssemblyName>
    <ApplicationIcon>Assets\proguard-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF declares its DPI mode in the manifest; WinForms (tray icon only) would rather it came from code.
         WFAC010 on .NET 8, renamed WFO0003 on .NET 10. -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>
    <!-- The UI's text is in Resources\Strings.resx (English) and Strings.<culture>.resx (translations), with
         Resources\Strings.cs generated from it by tools\i18n\Update-Strings.ps1. Only ship those languages' satellites. -->
    <SatelliteResourceLanguages>en;es;de;fr;pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\proguard-icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The UI only ever talks to the engine. It deliberately has no reference to ProGuard.Core. -->
    <ProjectReference Include="..\ProGuard.Shared\ProGuard.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProGuard.Tests" />
  </ItemGroup>

</Project>
