<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>ProGuard.UI</RootNamespace>
    <AssemblyName>ProGuard.UI</AssemblyName>
    <ApplicationIcon>Assets\proguard-icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The UI only ever talks to the engine. It deliberately has no reference to ProGuard.Core. -->
    <ProjectReference Include="..\ProGuard.Shared\ProGuard.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProGuard.Tests" />
  </ItemGroup>

</Project>
