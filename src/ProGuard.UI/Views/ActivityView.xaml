<UserControl x:Class="ProGuard.UI.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:r="clr-namespace:ProGuard.UI.Resources"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
                <Border Style="{StaticResource Tag}" Margin="0,0,10,0" Visibility="{Binding IsAdministrator, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                    <TextBlock Text="{x:Static r:Strings.Admin}" Style="{StaticResource Tag.Text}"/>
                </Border>
                <Button Style="{StaticResource Btn.Outline}" Content="{x:Static r:Strings.ClearLog}" Command="{Binding ClearLogCommand}" IsEnabled="{Binding IsAdministrator}"
                        ToolTip="{x:Static r:Strings.EmptiesTheActivityLogForEveryone}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="{x:Static r:Strings.Activity}" Style="{StaticResource Text.Title}"/>
                <TextBlock Text="{x:Static r:Strings.EverythingProguardAndYouDidNewest}" Style="{StaticResource Text.Label}" Margin="0,6,0,0"/>
            </StackPanel>
        </DockPanel>

        <ListBox Grid.Row="1" Style="{StaticResource Choices}" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Margin="0,22,0,10"/>

        <Border Grid.Row="2" BorderBrush="{StaticResource VoltBrush}" BorderThickness="0,0,0,2" Padding="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static r:Strings.Time}" Style="{StaticResource Text.Label}" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="{x:Static r:Strings.What}" Style="{StaticResource Text.Label}" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" Text="{x:Static r:Strings.Process}" Style="{StaticResource Text.Label}" FontWeight="Bold"/>
                <TextBlock Grid.Column="3" Text="{x:Static r:Strings.Detail}" Style="{StaticResource Text.Label}" FontWeight="Bold"/>
            </Grid>
        </Border>

        <ListBox Grid.Row="3" Style="{StaticResource Table}" ItemContainerStyle="{StaticResource Table.Row}" ItemsSource="{Binding Entries}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Time}" FontFamily="{StaticResource Mono}" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Style="{StaticResource Tag}" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Kind}" Style="{StaticResource Tag.Text}"/>
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding Process}" FontWeight="Bold" FontStretch="SemiCondensed" FontSize="14" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding Message}" FontSize="13.5" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,8"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}" IsHitTestVisible="False">
            <TextBlock Text="{x:Static r:Strings.AllQuiet}" Style="{StaticResource Text.Hero}" FontSize="110" LineHeight="96" Opacity="0.2"/>
            <TextBlock Style="{StaticResource Text.Body}" FontSize="16" MaxWidth="460" HorizontalAlignment="Left" Margin="0,22,0,0" Opacity="0.75"
                       Text="{x:Static r:Strings.WhenProbalanceStepsInARule}"/>
        </StackPanel>
    </Grid>
</UserControl>
