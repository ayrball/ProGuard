<UserControl x:Class="ProGuard.UI.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="ACTIVITY" Style="{StaticResource Text.Title}"/>
            <TextBlock Text="EVERYTHING PROGUARD — AND YOU — DID, NEWEST FIRST" Style="{StaticResource Text.Label}" Margin="0,6,0,0"/>
        </StackPanel>

        <ListBox Grid.Row="1" Style="{StaticResource Choices}" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Margin="0,22,0,10"/>

        <Border Grid.Row="2" BorderBrush="{StaticResource VoltBrush}" BorderThickness="0,0,0,2" Padding="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="TIME" Style="{StaticResource Text.Label}" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="WHAT" Style="{StaticResource Text.Label}" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" Text="PROCESS" Style="{StaticResource Text.Label}" FontWeight="Bold"/>
                <TextBlock Grid.Column="3" Text="DETAIL" Style="{StaticResource Text.Label}" FontWeight="Bold"/>
            </Grid>
        </Border>

        <ListBox Grid.Row="3" Style="{StaticResource Table}" ItemContainerStyle="{StaticResource Table.Row}" ItemsSource="{Binding Entries}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Time}" FontFamily="{StaticResource Mono}" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Style="{StaticResource Tag}" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Kind}" Style="{StaticResource Tag.Text}"/>
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding Process}" FontWeight="Bold" FontStretch="SemiCondensed" FontSize="14" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding Message}" FontSize="13.5" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,8"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}" IsHitTestVisible="False">
            <TextBlock Text="ALL&#x0a;QUIET." Style="{StaticResource Text.Hero}" FontSize="110" LineHeight="96" Opacity="0.2"/>
            <TextBlock Style="{StaticResource Text.Body}" FontSize="16" MaxWidth="460" HorizontalAlignment="Left" Margin="0,22,0,0" Opacity="0.75"
                       Text="When ProBalance steps in, a rule or watch fires, or you change a process, it shows up here."/>
        </StackPanel>
    </Grid>
</UserControl>
