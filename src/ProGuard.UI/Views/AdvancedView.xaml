<UserControl x:Class="ProGuard.UI.Views.AdvancedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:r="clr-namespace:ProGuard.UI.Resources"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ProGuard.UI.ViewModels"
             xmlns:views="clr-namespace:ProGuard.UI.Views">
    <UserControl.Resources>
        <!-- Sub-section pages: one DataTemplate per section's view model (see AdvancedViewModel). -->
        <DataTemplate DataType="{x:Type vm:CpuTuningViewModel}"><views:CpuTuningView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}"><views:LogsView/></DataTemplate>

        <!-- A sub-section tab: big condensed words, the current one underlined in volt. -->
        <Style x:Key="Section.Tab" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Label}"/>
            <Setter Property="Foreground" Value="{StaticResource VoltBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,30,0"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Volt}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <StackPanel Background="Transparent">
                            <TextBlock x:Name="Label" Text="{Binding Label}" FontFamily="{StaticResource Display}" FontWeight="Bold" FontStretch="Condensed"
                                       FontSize="24" Foreground="{TemplateBinding Foreground}" Opacity="0.4"/>
                            <Rectangle x:Name="Underline" Height="4" Fill="{StaticResource VoltBrush}" Margin="0,4,0,0" Visibility="Hidden"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Label" Property="Opacity" Value="1"/>
                                <Setter TargetName="Underline" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{x:Static r:Strings.Advanced}" Style="{StaticResource Text.Title}"/>
            <TextBlock Text="{Binding CurrentSection.Blurb}" Style="{StaticResource Text.Label}" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- The sub-sections. Each is a page of its own below the tabs. -->
        <Border Grid.Row="1" BorderBrush="{StaticResource VoltLineBrush}" BorderThickness="0,0,0,2" Margin="0,18,0,18">
            <ListBox AutomationProperties.AutomationId="AdvancedSections" Style="{StaticResource Choices}" ItemContainerStyle="{StaticResource Section.Tab}"
                     DisplayMemberPath="{x:Null}" ItemsSource="{Binding Sections}" SelectedItem="{Binding CurrentSection}" Margin="0,0,0,-2"/>
        </Border>

        <ContentControl Grid.Row="2" Content="{Binding CurrentSection.Page}" Focusable="False"/>
    </Grid>
</UserControl>
