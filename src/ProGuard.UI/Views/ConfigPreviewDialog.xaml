<UserControl x:Class="ProGuard.UI.Views.ConfigPreviewDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:r="clr-namespace:ProGuard.UI.Resources"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="Dialogs.xaml"/>
    </UserControl.Resources>
    <StackPanel Width="720">
        <TextBlock Text="{Binding Kicker}" Style="{StaticResource Dialog.Kicker}"/>
        <TextBlock Text="{Binding Title}" Style="{StaticResource Dialog.Title}"/>
        <TextBlock Text="{Binding Summary}" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="12" Margin="0,12,0,14"/>

        <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="0,0,10,0">
                <!-- What stops it: first, and inverted (ink on volt), so it can't be missed. -->
                <Border Background="{StaticResource VoltBrush}" Padding="14,10" Margin="0,0,0,14"
                        Visibility="{Binding HasBlockers, Converter={StaticResource VisibleWhen}}">
                    <StackPanel>
                        <TextBlock Text="{x:Static r:Strings.CantBeApplied}" Foreground="{StaticResource InkBrush}" FontWeight="Bold" FontSize="12"/>
                        <ItemsControl ItemsSource="{Binding Blockers}" Focusable="False" AutomationProperties.Name="CAN'T BE APPLIED">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="13"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Machine-specific values: left out, and said so. -->
                <StackPanel Visibility="{Binding HasMachineSpecific, Converter={StaticResource VisibleWhen}}" Margin="0,0,0,16">
                    <DockPanel Margin="0,0,0,6">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Tag}" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static r:Strings.LeftOut}" Style="{StaticResource Tag.Text}"/>
                        </Border>
                        <TextBlock Text="{x:Static r:Strings.OnlyForTheMachineItWas}" Style="{StaticResource Text.Label}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding MachineSpecific}" Focusable="False" AutomationProperties.Name="MACHINE-SPECIFIC VALUES">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource VoltLineBrush}" BorderThickness="2,0,0,0" Padding="10,4" Margin="0,4,0,0">
                                    <StackPanel>
                                        <TextBlock TextWrapping="Wrap" FontSize="13">
                                            <Run Text="{Binding Where, Mode=OneWay}" FontWeight="Bold"/><Run Text=" · "/><Run Text="{Binding Setting, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Value, Mode=OneWay}" FontFamily="{StaticResource Mono}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="12" Opacity="0.7" TextWrapping="Wrap">
                                            <Run Text="{Binding Reason, Mode=OneWay}"/><Run Text=". "/><Run Text="{Binding Outcome, Mode=OneWay}"/><Run Text="."/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock Text="{x:Static r:Strings.WhatChanges}" Style="{StaticResource Text.Label}" FontWeight="Bold" Margin="0,0,0,6"
                           Visibility="{Binding HasChanges, Converter={StaticResource VisibleWhen}}"/>
                <ItemsControl ItemsSource="{Binding Changes}" Focusable="False" AutomationProperties.Name="WHAT CHANGES">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Sign}" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Grid.Column="1" Text="{Binding Area}" FontFamily="{StaticResource Mono}" FontSize="10" Opacity="0.6" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding Name}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="3" Text="{Binding Detail}" FontSize="12.5" Opacity="0.75" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Text="{Binding BackupNote}" Style="{StaticResource Text.Body}" FontSize="13" Opacity="0.7" TextWrapping="Wrap" Margin="0,18,0,24"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Btn.Ghost}" Content="{x:Static r:Strings.Cancel}" Margin="0,0,10,0" Padding="20,12" IsCancel="True"
                    Command="{Binding DataContext.CloseDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Style="{StaticResource Btn.Solid}" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" Padding="22,12" FontSize="14"/>
        </StackPanel>
    </StackPanel>
</UserControl>
