<UserControl x:Class="ProGuard.UI.Views.ConfirmDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:r="clr-namespace:ProGuard.UI.Resources"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="Dialogs.xaml"/>
    </UserControl.Resources>
    <StackPanel MaxWidth="560">
        <TextBlock Text="{x:Static r:Strings.Confirm}" Style="{StaticResource Dialog.Kicker}"/>
        <TextBlock Text="{Binding Title}" Style="{StaticResource Dialog.Title}"/>
        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" FontSize="16" Opacity="0.8" Margin="0,16,0,30"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Btn.Ghost}" Content="{x:Static r:Strings.Cancel}" Margin="0,0,10,0" Padding="20,12" IsCancel="True"
                    Command="{Binding DataContext.CloseDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Style="{StaticResource Btn.Solid}" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" Padding="22,12" FontSize="14"/>
        </StackPanel>
    </StackPanel>
</UserControl>
