<UserControl x:Class="ProGuard.UI.Views.CpuLimitDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="Dialogs.xaml"/>
    </UserControl.Resources>
    <StackPanel Width="540">
        <TextBlock Text="CPU CAP" Style="{StaticResource Dialog.Kicker}"/>
        <TextBlock Text="{Binding Title}" Style="{StaticResource Dialog.Title}"/>

        <StackPanel Orientation="Horizontal" Margin="-4,18,0,0">
            <TextBlock Text="{Binding Whole}" Style="{StaticResource Text.Hero}" FontSize="120" LineHeight="104"/>
            <TextBlock Text="%" Style="{StaticResource Text.Title}" VerticalAlignment="Bottom" Margin="4,0,0,10" Opacity="0.55"/>
        </StackPanel>
        <TextBlock Text="OF THE WHOLE MACHINE — A HARD CEILING WINDOWS ENFORCES" Style="{StaticResource Text.Label}" Margin="0,4,0,10"/>

        <Slider Style="{StaticResource Slider}" Minimum="1" Maximum="99" Value="{Binding Percent}" SmallChange="1" LargeChange="5"/>

        <ItemsControl ItemsSource="{Binding Presets}" Margin="0,12,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- ContentStringFormat, not a StringFormat on the Content binding: WPF ignores that one for object-typed Content. -->
                    <Button Style="{StaticResource Btn.Outline}" Content="{Binding}" ContentStringFormat="{}{0}%" Margin="0,0,6,0" Padding="14,7"
                            AutomationProperties.Name="{Binding StringFormat='{}{0}%'}"
                            BorderBrush="{StaticResource VoltLineBrush}"
                            Command="{Binding DataContext.PresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <DockPanel Margin="0,30,0,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Ghost}" Content="REMOVE CAP" Command="{Binding RemoveCommand}"
                    Visibility="{Binding HasLimit, Converter={StaticResource VisibleWhen}}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Btn.Ghost}" Content="CANCEL" Margin="0,0,10,0" Padding="20,12" IsCancel="True"
                        Command="{Binding DataContext.CloseDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                <Button Style="{StaticResource Btn.Solid}" Content="APPLY CAP" Command="{Binding ApplyCommand}" Padding="26,12" FontSize="14"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</UserControl>
