<UserControl x:Class="ProGuard.UI.Views.CpuSetDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:r="clr-namespace:ProGuard.UI.Resources"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="Dialogs.xaml"/>
    </UserControl.Resources>
    <StackPanel Width="640">
        <TextBlock Text="{x:Static r:Strings.CpuSets}" Style="{StaticResource Dialog.Kicker}"/>
        <TextBlock Text="{Binding Title}" Style="{StaticResource Dialog.Title}"/>
        <TextBlock Style="{StaticResource Text.Body}" Opacity="0.7" Margin="0,10,0,18"
                   Text="{x:Static r:Strings.LitBlocksAreTheLogicalProcessors2}"/>

        <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Sets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding IsOn}" Margin="0,0,6,6" Padding="10,8" HorizontalContentAlignment="Left"
                                      AutomationProperties.Name="{Binding Footer, StringFormat={x:Static r:Strings.CpuSet0}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontFamily="{StaticResource Mono}" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Detail}" FontFamily="{StaticResource Mono}" FontSize="10" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding Footer}" FontFamily="{StaticResource Mono}" FontSize="10" Opacity="0.6"/>
                            </StackPanel>
                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Style="{StaticResource Btn.Ghost}" Content="{x:Static r:Strings.All}" Command="{Binding AllCommand}"/>
                <Button Style="{StaticResource Btn.Ghost}" Content="{x:Static r:Strings.PCores}" Command="{Binding FastCommand}"
                        Visibility="{Binding IsHybrid, Converter={StaticResource VisibleWhen}}"/>
                <Button Style="{StaticResource Btn.Ghost}" Content="{x:Static r:Strings.ECores}" Command="{Binding SlowCommand}"
                        Visibility="{Binding IsHybrid, Converter={StaticResource VisibleWhen}}"/>
                <Button Style="{StaticResource Btn.Ghost}" Content="{x:Static r:Strings.None}" Command="{Binding NoneCommand}"/>
            </StackPanel>
        </DockPanel>
        <TextBlock Text="{Binding Summary}" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <DockPanel Margin="0,26,0,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Ghost}" Content="{x:Static r:Strings.LeaveAlone}" Command="{Binding LeaveAloneCommand}"
                    Visibility="{Binding CanLeaveAlone, Converter={StaticResource VisibleWhen}}"
                    ToolTip="{x:Static r:Strings.StopTheRuleFromTouchingThe}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Btn.Ghost}" Content="{x:Static r:Strings.Cancel}" Margin="0,0,10,0" Padding="20,12" IsCancel="True"
                        Command="{Binding DataContext.CloseDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                <Button Style="{StaticResource Btn.Solid}" Content="{x:Static r:Strings.Apply}" Command="{Binding ApplyCommand}" Padding="26,12" FontSize="14"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</UserControl>
