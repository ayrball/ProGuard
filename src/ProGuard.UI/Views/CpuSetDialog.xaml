<UserControl x:Class="ProGuard.UI.Views.CpuSetDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="Dialogs.xaml"/>
    </UserControl.Resources>
    <StackPanel Width="640">
        <TextBlock Text="CPU SETS" Style="{StaticResource Dialog.Kicker}"/>
        <TextBlock Text="{Binding Title}" Style="{StaticResource Dialog.Title}"/>
        <TextBlock Style="{StaticResource Text.Body}" Opacity="0.7" Margin="0,10,0,18"
                   Text="Lit blocks are the logical processors Windows prefers for this program. Unlike core affinity this is a preference, so the program can still spill over when they are busy."/>

        <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Sets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding IsOn}" Margin="0,0,6,6" Padding="10,8" HorizontalContentAlignment="Left">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontFamily="{StaticResource Mono}" FontSize="20" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Detail}" FontFamily="{StaticResource Mono}" FontSize="10" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding Footer}" FontFamily="{StaticResource Mono}" FontSize="10" Opacity="0.6"/>
                            </StackPanel>
                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <DockPanel Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Style="{StaticResource Btn.Ghost}" Content="ALL" Command="{Binding AllCommand}"/>
                <Button Style="{StaticResource Btn.Ghost}" Content="P-CORES" Command="{Binding FastCommand}"
                        Visibility="{Binding IsHybrid, Converter={StaticResource VisibleWhen}}"/>
                <Button Style="{StaticResource Btn.Ghost}" Content="E-CORES" Command="{Binding SlowCommand}"
                        Visibility="{Binding IsHybrid, Converter={StaticResource VisibleWhen}}"/>
                <Button Style="{StaticResource Btn.Ghost}" Content="NONE" Command="{Binding NoneCommand}"/>
            </StackPanel>
        </DockPanel>
        <TextBlock Text="{Binding Summary}" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <DockPanel Margin="0,26,0,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Ghost}" Content="LEAVE ALONE" Command="{Binding LeaveAloneCommand}"
                    Visibility="{Binding CanLeaveAlone, Converter={StaticResource VisibleWhen}}"
                    ToolTip="Stop the rule from touching the program's CPU Sets at all."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Btn.Ghost}" Content="CANCEL" Margin="0,0,10,0" Padding="20,12" IsCancel="True"
                        Command="{Binding DataContext.CloseDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                <Button Style="{StaticResource Btn.Solid}" Content="APPLY" Command="{Binding ApplyCommand}" Padding="26,12" FontSize="14"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</UserControl>
