<UserControl x:Class="ProGuard.UI.Views.CpuTuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ProGuard.UI.Controls"
             xmlns:vm="clr-namespace:ProGuard.UI.ViewModels">
    <UserControl.Resources>
        <Style x:Key="Group" TargetType="TextBlock" BasedOn="{StaticResource Text.H2}">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="Margin" Value="0,30,0,4"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- A setting: name, class tag and one-line explanation; then its slider or choices; then its value. -->
        <DataTemplate x:Key="Row" DataType="{x:Type vm:CpuTuningRow}">
            <Border BorderBrush="{StaticResource VoltLineBrush}" BorderThickness="0,2,0,0" Padding="0,14,0,14"
                    AutomationProperties.Name="{Binding Key}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,24,0">
                        <WrapPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontStretch="SemiCondensed" FontSize="15" Margin="0,0,8,0"/>
                            <Border Style="{StaticResource Tag}" Visibility="{Binding ClassLabel, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Text="{Binding ClassLabel}" Style="{StaticResource Tag.Text}"/>
                            </Border>
                            <Border Style="{StaticResource Tag}" Opacity="0.5" Visibility="{Binding HiddenInWindows, Converter={StaticResource VisibleWhen}}"
                                    ToolTip="Windows' Power Options doesn't show this setting. ProGuard shows it there once it changes it.">
                                <TextBlock Text="HIDDEN" Style="{StaticResource Tag.Text}"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Body}" FontSize="12.5" Opacity="0.65" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Unavailable: the reason instead of a control. -->
                    <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding UnavailableReason, StringFormat='UNAVAILABLE · {0}'}" Style="{StaticResource Note}"
                               VerticalAlignment="Center" Visibility="{Binding IsAvailable, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Visibility="{Binding IsAvailable, Converter={StaticResource VisibleWhen}}"
                                IsEnabled="{Binding DataContext.IsAdministrator, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <!-- Read only for a standard user: the engine would refuse the change. -->
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Slider Style="{StaticResource Slider}" AutomationProperties.Name="{Binding Name}"
                                Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" SmallChange="{Binding Step}" LargeChange="10"
                                Value="{Binding Value}" Visibility="{Binding IsChoice, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"/>
                        <ItemsControl ItemsSource="{Binding Choices}" Focusable="False" AutomationProperties.Name="{Binding Name}"
                                      Visibility="{Binding IsChoice, Converter={StaticResource VisibleWhen}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Opt}" Content="{Binding Label}" ui:Seg.IsOn="{Binding IsOn, Mode=OneWay}"
                                            Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Reference}" Style="{StaticResource Note}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding LiveNote}" Style="{StaticResource Note}" Opacity="1" FontWeight="Bold" Margin="0,2,0,0"
                                   Visibility="{Binding LiveNote, Converter={StaticResource VisibleWhen}}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="17"
                               HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap"
                               Visibility="{Binding ShowsValue, Converter={StaticResource VisibleWhen}}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,16,0">
            <!-- The warning: whole machine, this plan. Solid volt, the one block on the page that shouts. -->
            <Border Background="{StaticResource VoltBrush}" Padding="16,11" AutomationProperties.AutomationId="CpuTuningWarning">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="!" Foreground="{StaticResource InkBrush}" FontWeight="Bold" FontSize="20" Margin="0,-3,14,0"/>
                    <TextBlock Text="{Binding Warning}" Foreground="{StaticResource InkBrush}" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Plan picker -->
            <TextBlock Text="POWER PLAN" Style="{StaticResource Text.Label}" Margin="0,22,0,8"/>
            <ItemsControl ItemsSource="{Binding Plans}" Focusable="False" AutomationProperties.Name="POWER PLAN">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Opt}" Content="{Binding Label}" ui:Seg.IsOn="{Binding IsOn, Mode=OneWay}"
                                Command="{Binding DataContext.PickPlanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Margin="0,2,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Note}">
                        <Setter Property="Text" Value="NOT THE ACTIVE PLAN"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActivePlan}" Value="True">
                                <Setter Property="Text" Value="THE ACTIVE PLAN"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Live parking -->
            <DockPanel Margin="0,26,0,10">
                <TextBlock DockPanel.Dock="Right" Text="LIVE · PARKED CORES ARE THE FAINT ONES" Style="{StaticResource Note}" VerticalAlignment="Bottom"/>
                <TextBlock Text="CORES NOW" Style="{StaticResource Text.Label}" FontWeight="Bold"/>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding CoreGroups}" Focusable="False" AutomationProperties.AutomationId="CoreParking">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CoreParkGroup}">
                        <StackPanel Margin="0,0,20,0" AutomationProperties.Name="{Binding Label}">
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}"/>
                            </DockPanel>
                            <ui:ParkBars Loads="{Binding Loads}" Parked="{Binding Parked}" Height="56"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0" Visibility="{Binding ParkingOverrideActive, Converter={StaticResource VisibleWhen}}"
                       Opacity="1" FontWeight="Bold"
                       Text="PROBALANCE IS RESTRAINING AND HOLDS EVERY CORE OF THIS PLAN UNPARKED. YOUR MIN CORES VALUES COME BACK WHEN IT LETS GO."/>

            <!-- Presets and revert -->
            <TextBlock Text="PRESETS" Style="{StaticResource Text.Label}" FontWeight="Bold" Margin="0,28,0,10"/>
            <ItemsControl ItemsSource="{Binding Presets}" Focusable="False" IsEnabled="{Binding IsAdministrator}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CpuTuningPreset}">
                        <Button Style="{StaticResource Btn.Outline}" Margin="0,0,8,0" Padding="14,10" HorizontalContentAlignment="Left"
                                AutomationProperties.Name="{Binding Label}"
                                Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Id}">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding Blurb}" FontWeight="Normal" FontSize="11.5" Opacity="0.7" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Solid}" Content="REVERT" Padding="18,8" Command="{Binding RevertCommand}"
                        IsEnabled="{Binding HasOriginals}" Visibility="{Binding IsAdministrator, Converter={StaticResource VisibleWhen}}"
                        ToolTip="Back to this plan's values before ProGuard first changed it"/>
                <TextBlock Text="{Binding OriginalsNote}" Style="{StaticResource Note}" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Plugged in / on battery -->
            <UniformGrid Rows="1" Columns="2" Width="360" HorizontalAlignment="Left" Margin="0,30,0,0">
                <Button Style="{StaticResource Seg}" Content="PLUGGED IN" Command="{Binding UsePowerSourceCommand}" CommandParameter="AC"
                        ui:Seg.IsOn="{Binding IsDc, Converter={StaticResource EqualsParameter}, ConverterParameter=False, Mode=OneWay}"/>
                <Button Style="{StaticResource Seg}" Content="ON BATTERY" Command="{Binding UsePowerSourceCommand}" CommandParameter="DC"
                        ui:Seg.IsOn="{Binding IsDc, Mode=OneWay}"/>
            </UniformGrid>

            <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CpuTuningGroup}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Group}"/>
                            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource Row}" Focusable="False"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
