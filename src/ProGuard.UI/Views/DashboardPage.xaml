<Page x:Class="ProGuard.UI.Views.DashboardPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
         xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
         Title="Dashboard">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Stats Cards -->
        <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,16">
            <ui:CardControl Margin="0,0,8,0">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="CPU Usage" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding CpuUsageText}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:SymbolIcon Symbol="DataHistogram24" FontSize="32" Foreground="{DynamicResource SystemFillColorAttentionBrush}"/>
            </ui:CardControl>
            
            <ui:CardControl Margin="8,0,8,0">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="RAM Usage" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding RamUsageText}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="32" Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
            </ui:CardControl>

            <ui:CardControl Margin="8,0,8,0">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="ProBalance Actions" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding ProBalanceCount}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:SymbolIcon Symbol="Flash24" FontSize="32" Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
            </ui:CardControl>

            <ui:CardControl Margin="8,0,0,0">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Active Rules" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding ActiveRulesCount}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:SymbolIcon Symbol="Book24" FontSize="32" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
            </ui:CardControl>
        </UniformGrid>

        <!-- CPU Chart -->
        <ui:CardControl Grid.Row="1" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="System CPU %" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <lvc:CartesianChart Grid.Row="1" Series="{Binding CpuSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" />
            </Grid>
        </ui:CardControl>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- RAM Chart -->
            <ui:CardControl Grid.Column="0" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="System RAM %" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <lvc:CartesianChart Grid.Row="1" Series="{Binding RamSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" />
                </Grid>
            </ui:CardControl>

            <!-- Top Consumers -->
            <ui:CardControl Grid.Column="1" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Top 5 CPU Consumers" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding TopConsumers}" AutoGenerateColumns="False" 
                              IsReadOnly="True" HeadersVisibility="Column" Background="Transparent" 
                              BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                              RowHeight="34" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="2*" MinWidth="120" ElementStyle="{StaticResource FluentDataGridTextStyle}"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80" ElementStyle="{StaticResource FluentDataGridTextStyle}"/>
                            <DataGridTextColumn Header="CPU %" Binding="{Binding CpuPercent}" Width="90" ElementStyle="{StaticResource FluentDataGridTextStyle}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </ui:CardControl>
        </Grid>
    </Grid>
</Page>
