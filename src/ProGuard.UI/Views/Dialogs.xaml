<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared bits for the dialog views. -->
    <Style x:Key="Dialog.Kicker" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="Dialog.Title" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}">
        <Setter Property="FontSize" Value="46"/>
        <Setter Property="LineHeight" Value="44"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
</ResourceDictionary>
