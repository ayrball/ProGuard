<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:r="clr-namespace:ProGuard.UI.Resources"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:ProGuard.UI.ViewModels">
    <!-- Shared bits for the Rules and Watchdog editors. Built from the Volt brushes and styles; nothing new in the palette. -->

    <!-- A collapsible group. Header = title; Tag = what the group is set to, shown while it is collapsed. -->
    <Style x:Key="Section" TargetType="Expander">
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Foreground" Value="{StaticResource VoltBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border BorderBrush="{StaticResource VoltLineBrush}" BorderThickness="2">
                        <DockPanel>
                            <ToggleButton x:Name="Head" DockPanel.Dock="Top" Foreground="{StaticResource VoltBrush}" Cursor="Hand"
                                          FocusVisualStyle="{StaticResource Focus.Volt}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Content="{TemplateBinding Header}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="Transparent" Padding="14,11" SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="Mark" Text="+" Width="24" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="16"
                                                           VerticalAlignment="Center"/>
                                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" TextElement.FontFamily="{StaticResource Display}"
                                                                  TextElement.FontWeight="Bold" TextElement.FontStretch="Condensed" TextElement.FontSize="20"/>
                                                <TextBlock x:Name="Sum" Grid.Column="2" Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"
                                                           FontFamily="{StaticResource Mono}" FontSize="10.5" Opacity="0.6"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource VoltGhostBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Mark" Property="Text" Value="–"/>
                                                <Setter TargetName="Sum" Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="BodyWrap" BorderBrush="{StaticResource VoltLineBrush}" BorderThickness="0,2,0,0" Visibility="Collapsed">
                                <ContentPresenter Margin="16,2,16,16"/>
                            </Border>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="BodyWrap" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Ed.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
        <Setter Property="Margin" Value="0,16,0,6"/>
    </Style>

    <Style x:Key="Ed.Note" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Opacity" Value="0.6"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <Style x:Key="Ed.Num" TargetType="TextBox" BasedOn="{StaticResource Field}">
        <Setter Property="FontFamily" Value="{StaticResource Mono}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- The one-line "what a standard user can't do" strip at the top of an editor. -->
    <Style x:Key="Ed.Hint" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource VoltLineBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="Padding" Value="20,10"/>
    </Style>

    <!-- Choices where some entries are only for administrators: they get an ADMIN tag and switch off for anyone else. -->
    <DataTemplate x:Key="Choice.Gated.Item">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Label}"/>
            <Border x:Name="AdminTag" Style="{StaticResource Tag}" Margin="8,0,0,0" Padding="4,0" Visibility="Collapsed">
                <TextBlock Text="{x:Static r:Strings.Admin}" Style="{StaticResource Tag.Text}" FontSize="9"/>
            </Border>
        </StackPanel>
        <DataTemplate.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding AdminOnly}" Value="True"/>
                    <Condition Binding="{Binding DataContext.IsRestricted, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="AdminTag" Property="Visibility" Value="Visible"/>
            </MultiDataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="Choice.Gated" TargetType="ListBoxItem" BasedOn="{StaticResource Choice}">
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding AdminOnly}" Value="True"/>
                    <Condition Binding="{Binding DataContext.IsRestricted, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="IsEnabled" Value="False"/>
                <Setter Property="Opacity" Value="0.4"/>
                <Setter Property="Cursor" Value="Arrow"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Choices.Gated" TargetType="ListBox" BasedOn="{StaticResource Choices}">
        <Setter Property="DisplayMemberPath" Value="{x:Null}"/>
        <Setter Property="ItemTemplate" Value="{StaticResource Choice.Gated.Item}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Choice.Gated}"/>
    </Style>

    <!-- Logical processors as lit blocks, with shortcuts. -->
    <DataTemplate DataType="{x:Type vm:CorePicker}">
        <StackPanel>
            <ItemsControl ItemsSource="{Binding Cores}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding IsOn}" Content="{Binding Label}" Padding="0,6" Margin="0,0,4,4"
                                      FontFamily="{StaticResource Mono}" FontSize="11"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Summary}" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="12" Margin="0,4,0,0"/>
            <WrapPanel Margin="-10,4,0,0">
                <Button Style="{StaticResource Btn.Ghost}" Content="{x:Static r:Strings.All}" Command="{Binding AllCommand}" Padding="8,4" FontSize="11"/>
                <Button Style="{StaticResource Btn.Ghost}" Content="{x:Static r:Strings.OnePerCore}" Command="{Binding EveryOtherCommand}" Padding="8,4" FontSize="11"
                        ToolTip="{x:Static r:Strings.EveryOtherThreadOnMostCpus}"/>
                <Button Style="{StaticResource Btn.Ghost}" Content="{x:Static r:Strings.FirstHalf}" Command="{Binding FirstHalfCommand}" Padding="8,4" FontSize="11"/>
                <Button Style="{StaticResource Btn.Ghost}" Content="{x:Static r:Strings.SecondHalf}" Command="{Binding SecondHalfCommand}" Padding="8,4" FontSize="11"/>
            </WrapPanel>
        </StackPanel>
    </DataTemplate>

    <!-- A length of time: a number, SEC or MIN, and common values to pick. -->
    <DataTemplate DataType="{x:Type vm:DurationInput}">
        <StackPanel>
            <DockPanel>
                <ListBox DockPanel.Dock="Right" Style="{StaticResource Choices}" ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}"
                         AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource AncestorType=ContentControl}, StringFormat={x:Static r:Strings.N0Unit}}"
                         Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBox Style="{StaticResource Ed.Num}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource AncestorType=ContentControl}}"/>
            </DockPanel>
            <ListBox Style="{StaticResource Choices}" ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" Margin="0,8,0,0"
                     AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource AncestorType=ContentControl}, StringFormat={x:Static r:Strings.N0Presets}}"/>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
