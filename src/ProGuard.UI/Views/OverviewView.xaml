<UserControl x:Class="ProGuard.UI.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:r="clr-namespace:ProGuard.UI.Resources"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ProGuard.UI.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
        <!-- Standard rights: first thing on the page, so it is never below the fold. -->
        <Border Margin="0,0,16,24" Padding="14,10" Background="{StaticResource VoltBrush}" VerticalAlignment="Top"
                Visibility="{Binding IsElevated, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
            <TextBlock Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="13"
                       Text="{x:Static r:Strings.YouAreRunningProguardWithoutAdministrator}"/>
        </Border>
    <Grid Margin="0,0,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="44"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================================================ CPU -->
        <StackPanel Grid.Column="0">
            <DockPanel>
                <TextBlock Text="{Binding CoresText}" DockPanel.Dock="Right" Style="{StaticResource Text.Label}" VerticalAlignment="Bottom"/>
                <TextBlock Text="{x:Static r:Strings.CpuLoad}" Style="{StaticResource Text.Label}" FontSize="13"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="-6,22,0,0">
                <TextBlock Text="{Binding Cpu}" Style="{StaticResource Text.Hero}" FontSize="150" LineHeight="128"/>
                <TextBlock Text="%" Style="{StaticResource Text.Title}" VerticalAlignment="Bottom" Margin="4,0,0,14" Opacity="0.55"/>
            </StackPanel>
            <ui:BlockMeter Value="{Binding Cpu}" Blocks="32" Height="16" Gap="3" Margin="0,8,0,0"/>
            <ui:Sparkline Values="{Binding Hub.CpuHistory}" Stroke="{StaticResource VoltBrush}" Fill="{StaticResource VoltGhostBrush}"
                          Height="90" Margin="0,18,0,0"/>
            <Rectangle Height="2" Fill="{StaticResource VoltLineBrush}"/>
            <DockPanel Margin="0,6,0,0">
                <TextBlock Text="{x:Static r:Strings.Now}" DockPanel.Dock="Right" FontFamily="{StaticResource Mono}" FontSize="10" Opacity="0.45"/>
                <TextBlock Text="{x:Static r:Strings.N90Seconds}" FontFamily="{StaticResource Mono}" FontSize="10" Opacity="0.45"/>
            </DockPanel>

            <!-- Each logical processor on its own. -->
            <DockPanel Margin="0,20,0,8">
                <TextBlock Text="{Binding CoreLoads.Count, StringFormat={x:Static r:Strings.N0Threads}}" DockPanel.Dock="Right" FontFamily="{StaticResource Mono}" FontSize="10" Opacity="0.45"/>
                <TextBlock Text="{x:Static r:Strings.EachCore}" Style="{StaticResource Text.Label}"/>
            </DockPanel>
            <ui:CoreBars Values="{Binding CoreLoads}" Height="44" Gap="3"/>
        </StackPanel>

        <!-- ============================================================ Memory -->
        <StackPanel Grid.Column="2">
            <DockPanel>
                <TextBlock Text="{Binding MemoryDetail}" DockPanel.Dock="Right" Style="{StaticResource Text.Label}" VerticalAlignment="Bottom"/>
                <TextBlock Text="{x:Static r:Strings.Memory}" Style="{StaticResource Text.Label}" FontSize="13"/>
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="-6,22,0,0">
                <TextBlock Text="{Binding Memory}" Style="{StaticResource Text.Hero}" FontSize="150" LineHeight="128"/>
                <TextBlock Text="%" Style="{StaticResource Text.Title}" VerticalAlignment="Bottom" Margin="4,0,0,14" Opacity="0.55"/>
            </StackPanel>
            <ui:BlockMeter Value="{Binding Memory}" Blocks="32" Height="16" Gap="3" Margin="0,8,0,0"/>
            <ui:Sparkline Values="{Binding Hub.MemoryHistory}" Stroke="{StaticResource VoltBrush}" Fill="{StaticResource VoltGhostBrush}"
                          Height="90" Margin="0,18,0,0"/>
            <Rectangle Height="2" Fill="{StaticResource VoltLineBrush}"/>
            <DockPanel Margin="0,6,0,0">
                <TextBlock Text="{x:Static r:Strings.Now}" DockPanel.Dock="Right" FontFamily="{StaticResource Mono}" FontSize="10" Opacity="0.45"/>
                <TextBlock Text="{x:Static r:Strings.N90Seconds}" FontFamily="{StaticResource Mono}" FontSize="10" Opacity="0.45"/>
            </DockPanel>

            <!-- The engine's own state, one line each. -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{x:Static r:Strings.Responsiveness}" Style="{StaticResource Text.Label}" Margin="0,9,0,9"/>
                <DockPanel Grid.Column="1" Margin="0,9">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ResponsivenessText}" FontFamily="{StaticResource Mono}" FontWeight="Bold" FontSize="14" Margin="12,0,0,0"/>
                    <ui:BlockMeter Value="{Binding Responsiveness}" Blocks="20" Height="12" Gap="2" VerticalAlignment="Center"/>
                </DockPanel>

                <TextBlock Grid.Row="1" Text="{x:Static r:Strings.Probalance}" Style="{StaticResource Text.Label}" Margin="0,9"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,7">
                    <Border Style="{StaticResource Tag}" Margin="0,0,10,0">
                        <TextBlock Text="{Binding ProBalanceState}" Style="{StaticResource Tag.Text}"/>
                    </Border>
                    <TextBlock Text="{Binding RestraintsText}" FontFamily="{StaticResource Mono}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="{x:Static r:Strings.PerformanceMode}" Style="{StaticResource Text.Label}" Margin="0,9"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,7">
                    <Border Style="{StaticResource Tag}">
                        <TextBlock Text="{Binding PerformanceModeText}" Style="{StaticResource Tag.Text}"/>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="3" Text="{x:Static r:Strings.PowerPlan}" Style="{StaticResource Text.Label}" Margin="0,9"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,5">
                    <TextBlock Text="{Binding ActivePlan}" FontWeight="Bold" FontStretch="SemiCondensed" FontSize="16" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding PlanOwner}" FontFamily="{StaticResource Mono}" FontSize="10.5" Opacity="0.55"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- ============================================================ lower band -->
        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,34,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Stat tiles: the first is a solid volt block, the rest are outlined. -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <UniformGrid Columns="2" Rows="2">
                    <Button Style="{StaticResource Btn.Solid}" Command="{Binding OpenProcessesCommand}" Padding="18,14" Margin="0,0,6,6"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ToolTip="{x:Static r:Strings.OpenTheProcessTable}">
                        <Grid>
                            <TextBlock Text="{x:Static r:Strings.Processes}" FontSize="11.5" FontWeight="SemiBold" Opacity="0.7" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding ProcessCount}" FontSize="58" FontWeight="Bold" FontStretch="Condensed" VerticalAlignment="Bottom" Margin="0,18,0,-8"/>
                            <TextBlock Text="&#xE72A;" Style="{StaticResource Text.Glyph}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                        </Grid>
                    </Button>
                    <Border BorderBrush="{StaticResource VoltBrush}" BorderThickness="2" Padding="18,14" Margin="0,0,0,6">
                        <Grid>
                            <TextBlock Text="{x:Static r:Strings.BalancedNow}" Style="{StaticResource Text.Label}" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding RestrainedCount}" FontSize="58" FontWeight="Bold" FontStretch="Condensed" VerticalAlignment="Bottom" Margin="0,18,0,-8"/>
                        </Grid>
                    </Border>
                    <Border BorderBrush="{StaticResource VoltLineBrush}" BorderThickness="2" Padding="18,14" Margin="0,0,6,0">
                        <Grid>
                            <TextBlock Text="{x:Static r:Strings.UnderARule}" Style="{StaticResource Text.Label}" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding RuledCount}" FontSize="58" FontWeight="Bold" FontStretch="Condensed" VerticalAlignment="Bottom" Margin="0,18,0,-8"/>
                        </Grid>
                    </Border>
                    <Border BorderBrush="{StaticResource VoltLineBrush}" BorderThickness="2" Padding="18,14">
                        <Grid>
                            <TextBlock Text="{x:Static r:Strings.CpuCapped}" Style="{StaticResource Text.Label}" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding LimitedCount}" FontSize="58" FontWeight="Bold" FontStretch="Condensed" VerticalAlignment="Bottom" Margin="0,18,0,-8"/>
                        </Grid>
                    </Border>
                </UniformGrid>

                <StackPanel Grid.Row="1" Margin="0,18,0,0">
                    <TextBlock Text="{x:Static r:Strings.InFocus}" Style="{StaticResource Text.Label}"/>
                    <DockPanel Margin="0,2,0,0">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Tag}" VerticalAlignment="Center"
                                Visibility="{Binding ProBalanceEnabled, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="{x:Static r:Strings.ProbalanceArmed}" Style="{StaticResource Tag.Text}"/>
                        </Border>
                        <Border DockPanel.Dock="Right" Style="{StaticResource Tag}" VerticalAlignment="Center"
                                Visibility="{Binding ProBalanceEnabled, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                            <TextBlock Text="{x:Static r:Strings.ProbalanceOff}" Style="{StaticResource Tag.Text}"/>
                        </Border>
                        <TextBlock Text="{Binding Foreground}" Style="{StaticResource Text.H2}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </StackPanel>


            </Grid>

            <!-- Top consumers -->
            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="{x:Static r:Strings.Cpu}" DockPanel.Dock="Right" Style="{StaticResource Text.Label}"/>
                    <TextBlock Text="{x:Static r:Strings.WhosWorkingHardest}" Style="{StaticResource Text.Label}" FontSize="13"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding TopConsumers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource VoltLineBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="58"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Rank, StringFormat='{}{0:00}'}" FontFamily="{StaticResource Mono}" FontSize="12" Opacity="0.45" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="17" FontStretch="SemiCondensed" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding MemoryText}" FontFamily="{StaticResource Mono}" FontSize="10.5" Opacity="0.5"/>
                                    </StackPanel>
                                    <ui:BlockMeter Grid.Column="2" Value="{Binding CpuPercent}" Maximum="25" Blocks="10" Height="12" Gap="2" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding CpuText}" FontFamily="{StaticResource Mono}" FontSize="16" FontWeight="Bold"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Grid>
    </Grid>
    </StackPanel>
    </ScrollViewer>
</UserControl>
