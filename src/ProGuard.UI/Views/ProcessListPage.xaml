<Page x:Class="ProGuard.UI.Views.ProcessListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Processes">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search Bar with Instant Clear Button -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <ui:TextBox PlaceholderText="Search processes by name or PID..." 
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            Icon="{ui:SymbolIcon Symbol=Search24}"
                            VerticalAlignment="Center"/>
                <ui:Button HorizontalAlignment="Right" VerticalAlignment="Center" 
                           Appearance="Transparent" Padding="4" Margin="0,0,6,0"
                           Command="{Binding ClearSearchCommand}" ToolTip="Clear search filter"
                           Visibility="{Binding HasSearchText, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ui:SymbolIcon Symbol="Dismiss16" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </ui:Button>
            </Grid>

            <!-- Quick Filter Presets (All, User, System, Active CPU, Heavy RAM) -->
            <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedFilterIndex, Mode=TwoWay}" 
                      Margin="0,0,12,0" Width="175" VerticalAlignment="Center">
                <ComboBoxItem Content="All Processes"/>
                <ComboBoxItem Content="User Processes"/>
                <ComboBoxItem Content="System Processes"/>
                <ComboBoxItem Content="Active (CPU > 0%)"/>
                <ComboBoxItem Content="Heavy RAM (> 500 MB)"/>
            </ComboBox>

            <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}" 
                       Content="Refresh"
                       Command="{Binding RefreshCommand}" Margin="0,0,12,0" ToolTip="Refresh process list"
                       VerticalAlignment="Center"/>

            <!-- 1-Click Global SmartTrim Flush -->
            <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon Symbol=Broom24}" 
                       Content="Trim All"
                       Command="{Binding TrimAllWorkingSetsCommand}" Margin="0,0,12,0" 
                       ToolTip="Flush Working Sets Across All System Processes (SmartTrim)"
                       VerticalAlignment="Center"/>
            
            <!-- Process Tree View Hierarchy Toggle -->
            <ui:ToggleSwitch Grid.Column="4" Content="Tree View" 
                             IsChecked="{Binding IsTreeView, Mode=TwoWay}" 
                             VerticalAlignment="Center"/>
        </Grid>

        <!-- Process DataGrid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                  RowHeight="38" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.CacheLength="20,20"
                  VirtualizingPanel.CacheLengthUnit="Item"
                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  ScrollViewer.CanContentScroll="True"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  CanUserResizeRows="False"
                  CanUserReorderColumns="False">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnRowRightClick" />
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <!-- Windows 11 Efficiency Mode (EcoQoS) -->
                    <MenuItem Header="Efficiency Mode (EcoQoS)" Command="{Binding ToggleEfficiencyModeCommand}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="LeafTwo24" Foreground="#107C41"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>

                    <!-- CPU Priority -->
                    <MenuItem Header="Set Priority">
                        <MenuItem Header="Realtime" Command="{Binding SetPriorityRealtimeCommand}"/>
                        <MenuItem Header="High" Command="{Binding SetPriorityHighCommand}"/>
                        <MenuItem Header="Above Normal" Command="{Binding SetPriorityAboveNormalCommand}"/>
                        <MenuItem Header="Normal" Command="{Binding SetPriorityNormalCommand}"/>
                        <MenuItem Header="Below Normal" Command="{Binding SetPriorityBelowNormalCommand}"/>
                        <MenuItem Header="Idle" Command="{Binding SetPriorityIdleCommand}"/>
                    </MenuItem>

                    <!-- I/O Priority -->
                    <MenuItem Header="I/O Priority">
                        <MenuItem Header="High" Command="{Binding SetIoPriorityHighCommand}"/>
                        <MenuItem Header="Normal" Command="{Binding SetIoPriorityNormalCommand}"/>
                        <MenuItem Header="Low" Command="{Binding SetIoPriorityLowCommand}"/>
                        <MenuItem Header="Very Low" Command="{Binding SetIoPriorityVeryLowCommand}"/>
                    </MenuItem>

                    <!-- Memory Priority -->
                    <MenuItem Header="Memory Priority">
                        <MenuItem Header="5 (Normal)" Command="{Binding SetMemoryPriority5Command}"/>
                        <MenuItem Header="4" Command="{Binding SetMemoryPriority4Command}"/>
                        <MenuItem Header="3" Command="{Binding SetMemoryPriority3Command}"/>
                        <MenuItem Header="2" Command="{Binding SetMemoryPriority2Command}"/>
                        <MenuItem Header="1 (Very Low)" Command="{Binding SetMemoryPriority1Command}"/>
                    </MenuItem>

                    <!-- CPU Affinity & SMT -->
                    <MenuItem Header="CPU Affinity">
                        <MenuItem Header="Configure CPU Affinity..." Command="{Binding SetAffinityCommand}"/>
                        <Separator/>
                        <MenuItem Header="Disable SMT (Physical Cores Only)" Command="{Binding DisableSmtCommand}"/>
                        <MenuItem Header="Enable SMT (All Cores)" Command="{Binding EnableSmtCommand}"/>
                    </MenuItem>

                    <!-- CPU Rate Limiter -->
                    <MenuItem Header="Set CPU Limit..." Command="{Binding SetCpuLimitCommand}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Gauge24"/>
                        </MenuItem.Icon>
                    </MenuItem>

                    <!-- Per-Process SmartTrim -->
                    <MenuItem Header="Trim Working Set (SmartTrim)" Command="{Binding TrimWorkingSetCommand}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Broom24"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>

                    <!-- Persistent Rule -->
                    <MenuItem Header="Create Persistent Rule" Command="{Binding CreateRuleCommand}"/>
                    <Separator/>

                    <!-- Process Lifecycle -->
                    <MenuItem Header="Terminate Process" Command="{Binding TerminateProcessCommand}"/>
                    <MenuItem Header="Terminate Process Tree" Command="{Binding KillProcessTreeCommand}">
                        <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Delete24" Foreground="#D13438"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Suspend" Command="{Binding SuspendProcessCommand}"/>
                    <MenuItem Header="Resume" Command="{Binding ResumeProcessCommand}"/>
                    <MenuItem Header="Open File Location" Command="{Binding OpenFileLocationCommand}"/>
                    <Separator/>
                    <MenuItem Header="Disallow Process" Command="{Binding DisallowProcessCommand}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            
            <DataGrid.Columns>
                <!-- Native Process Icon + Name / Indented Tree Display -->
                <DataGridTemplateColumn Header="Name" Width="2*" MinWidth="220">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="LowQuality"/>
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80" ElementStyle="{StaticResource FluentDataGridTextStyle}"/>
                <DataGridTextColumn Header="CPU %" Binding="{Binding CpuPercent}" Width="85" ElementStyle="{StaticResource FluentDataGridTextStyle}"/>
                <DataGridTextColumn Header="Memory" Binding="{Binding MemoryText}" Width="110" ElementStyle="{StaticResource FluentDataGridTextStyle}"/>
                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="110" ElementStyle="{StaticResource FluentDataGridTextStyle}"/>
                <DataGridTextColumn Header="Affinity" Binding="{Binding AffinityText}" Width="125" ElementStyle="{StaticResource FluentDataGridTextStyle}"/>
                <DataGridTextColumn Header="I/O" Binding="{Binding IoPriority}" Width="80" ElementStyle="{StaticResource FluentDataGridTextStyle}"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="95" ElementStyle="{StaticResource FluentDataGridTextStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Bottom Container: Real-Time Process Inspector + Status Bar -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Real-Time Process Inspector Card (Visible on Process Selection) -->
            <Border Grid.Row="0" Margin="0,0,0,10" Padding="14,10" CornerRadius="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="{Binding HasSelectedProcess, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Inspector Header: Process Icon, Name, PID, Parent PID & Quick Action Buttons -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" Source="{Binding SelectedProcess.Icon}" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedProcess.Name}" FontWeight="Bold" FontSize="14" Margin="0,0,12,0"/>
                            <TextBlock Text="PID: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedProcess.Pid}" FontWeight="SemiBold" FontSize="12" Margin="0,0,14,0"/>
                            <TextBlock Text="Parent PID: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedProcess.ParentPid}" FontWeight="SemiBold" FontSize="12"/>
                        </StackPanel>

                        <!-- Quick Action Toolbar for Selected Process -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="EcoQoS" Icon="{ui:SymbolIcon Symbol=LeafTwo24}" 
                                       Command="{Binding ToggleEfficiencyModeCommand}" 
                                       Padding="8,4" Margin="0,0,6,0" ToolTip="Toggle Windows 11 Efficiency Mode (EcoQoS)"/>
                            <ui:Button Content="Trim RAM" Icon="{ui:SymbolIcon Symbol=Broom24}" 
                                       Command="{Binding TrimWorkingSetCommand}" 
                                       Padding="8,4" Margin="0,0,6,0" ToolTip="Trim process working set"/>
                            <ui:Button Content="CPU Limit" Icon="{ui:SymbolIcon Symbol=Gauge24}" 
                                       Command="{Binding SetCpuLimitCommand}" 
                                       Padding="8,4" Margin="0,0,6,0" ToolTip="Configure CPU Rate Limiter"/>
                            <ui:Button Content="Tree Kill" Icon="{ui:SymbolIcon Symbol=Delete24}" 
                                       Command="{Binding KillProcessTreeCommand}" 
                                       Padding="8,4" ToolTip="Terminate process and all child processes"/>
                        </StackPanel>
                    </Grid>

                    <!-- Bottom Inspector Details: Threads, Handles, Started, I/O Pri, Mem Pri, File Path -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,18,0">
                            <TextBlock Text="Threads: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding SelectedProcess.ThreadCount}" FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,18,0">
                            <TextBlock Text="Handles: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding SelectedProcess.HandleCount}" FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,18,0">
                            <TextBlock Text="I/O Pri: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding SelectedProcess.IoPriority}" FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="0,0,18,0">
                            <TextBlock Text="Mem Pri: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding SelectedProcess.MemoryPriority}" FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="0,0,18,0">
                            <TextBlock Text="Started: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding SelectedProcess.StartTimeText}" FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>

                        <StackPanel Grid.Column="5" Orientation="Horizontal">
                            <TextBlock Text="Path: " Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding SelectedProcess.FilePath}" FontSize="11" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SelectedProcess.FilePath}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Status Bar -->
            <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}" 
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    Padding="12,8" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                        <ui:SymbolIcon Symbol="AppsList24" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                        <TextBlock Text="SmartTrim &amp; EcoQoS Ready" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
