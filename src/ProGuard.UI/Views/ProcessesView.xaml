<UserControl x:Class="ProGuard.UI.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ProGuard.UI.Controls"
             xmlns:vm="clr-namespace:ProGuard.UI.ViewModels">
    <UserControl.Resources>
        <!-- Column widths shared by the header and every row. -->
        <GridLength x:Key="ColIcon">34</GridLength>
        <GridLength x:Key="ColPid">66</GridLength>
        <GridLength x:Key="ColCpu">132</GridLength>
        <GridLength x:Key="ColMem">86</GridLength>
        <GridLength x:Key="ColPri">80</GridLength>
        <GridLength x:Key="ColCores">52</GridLength>

        <!-- A sortable column header: shows ▼ and full strength when it is the active sort. -->
        <Style x:Key="SortHeader" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
            <Setter Property="Padding" Value="0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Style.Triggers>
                <Trigger Property="ui:Seg.IsOn" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <ContextMenu x:Key="RowMenu" Opened="OnMenuOpened" Closed="OnMenuClosed">
            <MenuItem Header="Priority">
                <MenuItem Header="Realtime" Command="{Binding SetPriorityCommand}" CommandParameter="RealTime"
                          IsChecked="{Binding Selected.Priority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=RealTime}"/>
                <MenuItem Header="High" Command="{Binding SetPriorityCommand}" CommandParameter="High"
                          IsChecked="{Binding Selected.Priority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=High}"/>
                <MenuItem Header="Above normal" Command="{Binding SetPriorityCommand}" CommandParameter="AboveNormal"
                          IsChecked="{Binding Selected.Priority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=AboveNormal}"/>
                <MenuItem Header="Normal" Command="{Binding SetPriorityCommand}" CommandParameter="Normal"
                          IsChecked="{Binding Selected.Priority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=Normal}"/>
                <MenuItem Header="Below normal" Command="{Binding SetPriorityCommand}" CommandParameter="BelowNormal"
                          IsChecked="{Binding Selected.Priority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=BelowNormal}"/>
                <MenuItem Header="Idle" Command="{Binding SetPriorityCommand}" CommandParameter="Idle"
                          IsChecked="{Binding Selected.Priority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=Idle}"/>
            </MenuItem>
            <MenuItem Header="I/O priority">
                <MenuItem Header="High (administrator)" Command="{Binding SetIoPriorityCommand}" CommandParameter="3"
                          IsChecked="{Binding Selected.IoPriority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=3}"/>
                <MenuItem Header="Normal" Command="{Binding SetIoPriorityCommand}" CommandParameter="2"
                          IsChecked="{Binding Selected.IoPriority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=2}"/>
                <MenuItem Header="Low" Command="{Binding SetIoPriorityCommand}" CommandParameter="1"
                          IsChecked="{Binding Selected.IoPriority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=1}"/>
                <MenuItem Header="Very low" Command="{Binding SetIoPriorityCommand}" CommandParameter="0"
                          IsChecked="{Binding Selected.IoPriority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=0}"/>
            </MenuItem>
            <MenuItem Header="Memory priority">
                <MenuItem Header="Normal" Command="{Binding SetMemoryPriorityCommand}" CommandParameter="5"
                          IsChecked="{Binding Selected.MemoryPriority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=5}"/>
                <MenuItem Header="Below normal" Command="{Binding SetMemoryPriorityCommand}" CommandParameter="4"
                          IsChecked="{Binding Selected.MemoryPriority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=4}"/>
                <MenuItem Header="Medium" Command="{Binding SetMemoryPriorityCommand}" CommandParameter="3"
                          IsChecked="{Binding Selected.MemoryPriority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=3}"/>
                <MenuItem Header="Low" Command="{Binding SetMemoryPriorityCommand}" CommandParameter="2"
                          IsChecked="{Binding Selected.MemoryPriority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=2}"/>
                <MenuItem Header="Very low" Command="{Binding SetMemoryPriorityCommand}" CommandParameter="1"
                          IsChecked="{Binding Selected.MemoryPriority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=1}"/>
            </MenuItem>
            <MenuItem Header="CPU cap…" Command="{Binding EditCpuLimitCommand}"/>
            <MenuItem Header="Cores…" Command="{Binding EditAffinityCommand}"/>
            <MenuItem Header="Efficiency mode" Command="{Binding ToggleEfficiencyCommand}" IsChecked="{Binding Selected.IsEfficiencyMode, Mode=OneWay}"/>
            <Separator Style="{StaticResource Menu.Separator}"/>
            <MenuItem Header="Trim memory" Command="{Binding TrimCommand}"/>
            <MenuItem Command="{Binding ToggleSuspendCommand}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="Pause"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Selected.IsSuspended}" Value="True">
                                <Setter Property="Header" Value="Resume"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <Separator Style="{StaticResource Menu.Separator}"/>
            <MenuItem Header="Make a rule…" Command="{Binding MakeRuleCommand}"/>
            <MenuItem Header="Open file location" Command="{Binding OpenLocationCommand}"/>
            <Separator Style="{StaticResource Menu.Separator}"/>
            <MenuItem Header="End process" Command="{Binding EndCommand}" InputGestureText="DEL"/>
            <MenuItem Header="End process tree" Command="{Binding EndTreeCommand}"/>
        </ContextMenu>

        <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:ProcessRow}">
            <Grid Height="40" Margin="12,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource ColIcon}"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource ColPid}"/>
                    <ColumnDefinition Width="{StaticResource ColCpu}"/>
                    <ColumnDefinition Width="{StaticResource ColMem}"/>
                    <ColumnDefinition Width="{StaticResource ColPri}"/>
                    <ColumnDefinition Width="{StaticResource ColCores}"/>
                </Grid.ColumnDefinitions>

                <!-- Icon, or a monogram block until (or unless) one loads. -->
                <Grid Width="22" Height="22" HorizontalAlignment="Left">
                    <Border BorderBrush="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" BorderThickness="1.5"
                            Visibility="{Binding Icon, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                        <TextBlock Text="{Binding Monogram}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>

                <DockPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,12,0">
                        <Border Style="{StaticResource Tag}" Visibility="{Binding LimitText, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="{Binding LimitText}" Style="{StaticResource Tag.Text}"/>
                        </Border>
                        <Border Style="{StaticResource Tag}" Visibility="{Binding IsSuspended, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="PAUSED" Style="{StaticResource Tag.Text}"/>
                        </Border>
                        <Border Style="{StaticResource Tag}" Visibility="{Binding IsEfficiencyMode, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="ECO" Style="{StaticResource Tag.Text}"/>
                        </Border>
                        <Border Style="{StaticResource Tag}" Visibility="{Binding IsRestrained, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="BALANCED" Style="{StaticResource Tag.Text}"/>
                        </Border>
                        <Border Style="{StaticResource Tag}" Visibility="{Binding IsAffinityLimited, Converter={StaticResource VisibleWhen}}"
                                ToolTip="The CPU Limiter has taken cores away from this process for now">
                            <TextBlock Text="CORES LIMITED" Style="{StaticResource Tag.Text}"/>
                        </Border>
                        <Border Style="{StaticResource Tag}" Visibility="{Binding HasRule, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="RULE" Style="{StaticResource Tag.Text}"/>
                        </Border>
                        <Border Style="{StaticResource Tag}" Opacity="0.55" Visibility="{Binding IsSystem, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="SYS" Style="{StaticResource Tag.Text}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="  ◀ FOCUS" DockPanel.Dock="Right" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"
                               Visibility="{Binding IsForeground, Converter={StaticResource VisibleWhen}}"/>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>

                <TextBlock Grid.Column="2" Text="{Binding Pid}" FontFamily="{StaticResource Mono}" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>

                <Grid Grid.Column="3" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CpuText}" FontFamily="{StaticResource Mono}" FontSize="13" FontWeight="Bold"/>
                    <ui:BlockMeter Grid.Column="1" Value="{Binding CpuPercent}"
                                   Maximum="{Binding DataContext.CpuScale, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                   Blocks="10" Height="10" Gap="2"/>
                </Grid>

                <TextBlock Grid.Column="4" Text="{Binding MemoryText}" FontFamily="{StaticResource Mono}" FontSize="12.5" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="5" Text="{Binding PriorityText}" FontWeight="Bold" FontStretch="SemiCondensed" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="6" Text="{Binding AffinityText}" FontFamily="{StaticResource Mono}" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>

            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ heading -->
        <DockPanel Grid.ColumnSpan="2">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
                <StackPanel Margin="0,0,30,0">
                    <TextBlock Text="SHOWN" Style="{StaticResource Text.Label}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding ShownCount}" FontFamily="{StaticResource Mono}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="TOTAL CPU" Style="{StaticResource Text.Label}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding TotalCpuText, StringFormat='{}{0}%'}" FontFamily="{StaticResource Mono}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="PROCESSES" Style="{StaticResource Text.Title}"/>
                <TextBlock Text="{Binding TotalCount}" FontFamily="{StaticResource Mono}" FontSize="15" FontWeight="Bold" Opacity="0.5"
                           VerticalAlignment="Top" Margin="10,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ============================================================ search + filters -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,20,0,16">
            <Grid DockPanel.Dock="Left" Width="300" Margin="0,0,26,0">
                <TextBox x:Name="SearchBox" Style="{StaticResource Field}" Tag="SEARCH NAME OR PID" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Style="{StaticResource Btn.Ghost}" Content="&#xE711;" FontFamily="{StaticResource Glyphs}" FontWeight="Normal" FontSize="10"
                        HorizontalAlignment="Right" Padding="8" Command="{Binding ClearSearchCommand}" ToolTip="Clear"
                        Visibility="{Binding Search, Converter={StaticResource VisibleWhen}}"/>
            </Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource Chip.Radio}" Content="ALL" GroupName="pf"
                             IsChecked="{Binding Filter, Converter={StaticResource EqualsParameter}, ConverterParameter=All}"/>
                <RadioButton Style="{StaticResource Chip.Radio}" Content="APPS" GroupName="pf" ToolTip="Processes in your session"
                             IsChecked="{Binding Filter, Converter={StaticResource EqualsParameter}, ConverterParameter=Apps}"/>
                <RadioButton Style="{StaticResource Chip.Radio}" Content="SYSTEM" GroupName="pf" ToolTip="Services and Windows itself"
                             IsChecked="{Binding Filter, Converter={StaticResource EqualsParameter}, ConverterParameter=System}"/>
                <RadioButton Style="{StaticResource Chip.Radio}" Content="ACTIVE" GroupName="pf" ToolTip="Using any CPU right now"
                             IsChecked="{Binding Filter, Converter={StaticResource EqualsParameter}, ConverterParameter=Active}"/>
                <RadioButton Style="{StaticResource Chip.Radio}" Content="HEAVY" GroupName="pf" ToolTip="Using 500 MB or more"
                             IsChecked="{Binding Filter, Converter={StaticResource EqualsParameter}, ConverterParameter=Heavy}"/>
            </StackPanel>
        </DockPanel>

        <!-- ============================================================ column header -->
        <Border Grid.Row="2" BorderBrush="{StaticResource VoltBrush}" BorderThickness="0,0,0,2">
            <Grid Margin="12,0,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource ColIcon}"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource ColPid}"/>
                    <ColumnDefinition Width="{StaticResource ColCpu}"/>
                    <ColumnDefinition Width="{StaticResource ColMem}"/>
                    <ColumnDefinition Width="{StaticResource ColPri}"/>
                    <ColumnDefinition Width="{StaticResource ColCores}"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Style="{StaticResource SortHeader}" Content="NAME" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProcessSort.Name}"
                        ui:Seg.IsOn="{Binding Sort, Converter={StaticResource EqualsParameter}, ConverterParameter=Name, Mode=OneWay}"/>
                <Button Grid.Column="2" Style="{StaticResource SortHeader}" Content="PID" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProcessSort.Pid}"
                        ui:Seg.IsOn="{Binding Sort, Converter={StaticResource EqualsParameter}, ConverterParameter=Pid, Mode=OneWay}"/>
                <Button Grid.Column="3" Style="{StaticResource SortHeader}" Content="CPU ▼" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProcessSort.Cpu}"
                        ui:Seg.IsOn="{Binding Sort, Converter={StaticResource EqualsParameter}, ConverterParameter=Cpu, Mode=OneWay}"/>
                <Button Grid.Column="4" Style="{StaticResource SortHeader}" Content="MEMORY ▼" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProcessSort.Memory}"
                        ui:Seg.IsOn="{Binding Sort, Converter={StaticResource EqualsParameter}, ConverterParameter=Memory, Mode=OneWay}"/>
                <TextBlock Grid.Column="5" Text="PRIORITY" Style="{StaticResource Text.Label}" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="6" Text="CORES" Style="{StaticResource Text.Label}" FontWeight="Bold" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ============================================================ table -->
        <ListBox x:Name="Table" Grid.Row="3" Style="{StaticResource Table}" ItemContainerStyle="{StaticResource Table.Row}"
                 ItemTemplate="{StaticResource RowTemplate}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                 ContextMenu="{StaticResource RowMenu}"
                 MouseEnter="OnTableMouseEnter" MouseLeave="OnTableMouseLeave"
                 PreviewMouseRightButtonDown="OnTableRightButtonDown" KeyDown="OnTableKeyDown"/>

        <!-- ============================================================ inspector -->
        <Border Grid.Column="1" Grid.Row="2" Grid.RowSpan="2" Width="320" Margin="24,0,0,0" BorderBrush="{StaticResource VoltBrush}" BorderThickness="2"
                Visibility="{Binding Selected, Converter={StaticResource VisibleWhen}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{StaticResource VoltBrush}" Padding="20,16">
                        <StackPanel TextElement.Foreground="{StaticResource InkBrush}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Selected.Pid, StringFormat='PID {0}'}" FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="SELECTED" FontSize="11" FontWeight="SemiBold" Opacity="0.7"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Selected.Name}" FontWeight="Bold" FontStretch="Condensed" FontSize="30" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Selected.Path}" FontFamily="{StaticResource Mono}" FontSize="10" Opacity="0.7" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Selected.Path}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="20,18,20,22">
                        <UniformGrid Columns="2">
                            <StackPanel>
                                <TextBlock Text="CPU" Style="{StaticResource Text.Label}"/>
                                <TextBlock Text="{Binding Selected.CpuText, StringFormat='{}{0}%'}" FontWeight="Bold" FontStretch="Condensed" FontSize="40"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="MEMORY" Style="{StaticResource Text.Label}"/>
                                <TextBlock Text="{Binding Selected.MemoryText}" FontWeight="Bold" FontStretch="Condensed" FontSize="40"/>
                            </StackPanel>
                        </UniformGrid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="STARTED" Style="{StaticResource Text.Label}" Margin="0,3,16,3"/>
                            <TextBlock Grid.Column="1" Text="{Binding Selected.StartedText}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Text="PARENT" Style="{StaticResource Text.Label}" Margin="0,3,16,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.ParentPid}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,3"/>
                            <TextBlock Grid.Row="2" Text="CORES" Style="{StaticResource Text.Label}" Margin="0,3,16,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Selected.AffinityText}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,3"/>
                            <TextBlock Grid.Row="3" Text="USER" Style="{StaticResource Text.Label}" Margin="0,3,16,3"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Selected.UserText}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,3"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Selected.UserText}"/>
                            <TextBlock Grid.Row="4" Text="SESSION" Style="{StaticResource Text.Label}" Margin="0,3,16,3"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Selected.SessionId}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,3"/>
                            <TextBlock Grid.Row="5" Text="PRIVATE" Style="{StaticResource Text.Label}" Margin="0,3,16,3"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Selected.PrivateText}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,3"/>
                            <TextBlock Grid.Row="6" Text="THREADS" Style="{StaticResource Text.Label}" Margin="0,3,16,3"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Selected.ThreadCount}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,3"/>
                            <TextBlock Grid.Row="7" Text="I/O PRIORITY" Style="{StaticResource Text.Label}" Margin="0,3,16,3"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Selected.IoPriorityText}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,3"/>
                            <TextBlock Grid.Row="8" Text="MEMORY PRI." Style="{StaticResource Text.Label}" Margin="0,3,16,3"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Selected.MemoryPriorityText}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,3"/>
                        </Grid>

                        <TextBlock Text="PRIORITY" Style="{StaticResource Text.Label}" Margin="0,22,0,8"/>
                        <UniformGrid Columns="5">
                            <Button Style="{StaticResource Seg}" Content="IDLE" Command="{Binding SetPriorityCommand}" CommandParameter="Idle"
                                    ui:Seg.IsOn="{Binding Selected.Priority, Converter={StaticResource EqualsParameter}, ConverterParameter=Idle, Mode=OneWay}"/>
                            <Button Style="{StaticResource Seg}" Content="LOW" Command="{Binding SetPriorityCommand}" CommandParameter="BelowNormal"
                                    ui:Seg.IsOn="{Binding Selected.Priority, Converter={StaticResource EqualsParameter}, ConverterParameter=BelowNormal, Mode=OneWay}"/>
                            <Button Style="{StaticResource Seg}" Content="NORM" Command="{Binding SetPriorityCommand}" CommandParameter="Normal"
                                    ui:Seg.IsOn="{Binding Selected.Priority, Converter={StaticResource EqualsParameter}, ConverterParameter=Normal, Mode=OneWay}"/>
                            <Button Style="{StaticResource Seg}" Content="ABOVE" Command="{Binding SetPriorityCommand}" CommandParameter="AboveNormal"
                                    ui:Seg.IsOn="{Binding Selected.Priority, Converter={StaticResource EqualsParameter}, ConverterParameter=AboveNormal, Mode=OneWay}"/>
                            <Button Style="{StaticResource Seg}" Content="HIGH" Command="{Binding SetPriorityCommand}" CommandParameter="High"
                                    ui:Seg.IsOn="{Binding Selected.Priority, Converter={StaticResource EqualsParameter}, ConverterParameter=High, Mode=OneWay}"/>
                        </UniformGrid>

                        <DockPanel Margin="0,22,0,8">
                            <TextBlock DockPanel.Dock="Right" Text="HIGH NEEDS ADMIN" FontFamily="{StaticResource Mono}" FontSize="9.5" Opacity="0.5"
                                       Visibility="{Binding IsAdministrator, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"/>
                            <TextBlock Text="I/O PRIORITY" Style="{StaticResource Text.Label}"/>
                        </DockPanel>
                        <UniformGrid Columns="4">
                            <Button Style="{StaticResource Seg}" Content="V.LOW" Command="{Binding SetIoPriorityCommand}" CommandParameter="0"
                                    ui:Seg.IsOn="{Binding Selected.IoPriority, Converter={StaticResource EqualsParameter}, ConverterParameter=0, Mode=OneWay}"/>
                            <Button Style="{StaticResource Seg}" Content="LOW" Command="{Binding SetIoPriorityCommand}" CommandParameter="1"
                                    ui:Seg.IsOn="{Binding Selected.IoPriority, Converter={StaticResource EqualsParameter}, ConverterParameter=1, Mode=OneWay}"/>
                            <Button Style="{StaticResource Seg}" Content="NORM" Command="{Binding SetIoPriorityCommand}" CommandParameter="2"
                                    ui:Seg.IsOn="{Binding Selected.IoPriority, Converter={StaticResource EqualsParameter}, ConverterParameter=2, Mode=OneWay}"/>
                            <Button Style="{StaticResource Seg}" Content="HIGH" Command="{Binding SetIoPriorityCommand}" CommandParameter="3"
                                    ui:Seg.IsOn="{Binding Selected.IoPriority, Converter={StaticResource EqualsParameter}, ConverterParameter=3, Mode=OneWay}"/>
                        </UniformGrid>

                        <TextBlock Text="MEMORY PRIORITY" Style="{StaticResource Text.Label}" Margin="0,22,0,8"/>
                        <UniformGrid Columns="5">
                            <Button Style="{StaticResource Seg}" Content="V.LOW" Command="{Binding SetMemoryPriorityCommand}" CommandParameter="1"
                                    ui:Seg.IsOn="{Binding Selected.MemoryPriority, Converter={StaticResource EqualsParameter}, ConverterParameter=1, Mode=OneWay}"/>
                            <Button Style="{StaticResource Seg}" Content="LOW" Command="{Binding SetMemoryPriorityCommand}" CommandParameter="2"
                                    ui:Seg.IsOn="{Binding Selected.MemoryPriority, Converter={StaticResource EqualsParameter}, ConverterParameter=2, Mode=OneWay}"/>
                            <Button Style="{StaticResource Seg}" Content="MED" Command="{Binding SetMemoryPriorityCommand}" CommandParameter="3"
                                    ui:Seg.IsOn="{Binding Selected.MemoryPriority, Converter={StaticResource EqualsParameter}, ConverterParameter=3, Mode=OneWay}"/>
                            <Button Style="{StaticResource Seg}" Content="BELOW" Command="{Binding SetMemoryPriorityCommand}" CommandParameter="4"
                                    ui:Seg.IsOn="{Binding Selected.MemoryPriority, Converter={StaticResource EqualsParameter}, ConverterParameter=4, Mode=OneWay}"/>
                            <Button Style="{StaticResource Seg}" Content="NORM" Command="{Binding SetMemoryPriorityCommand}" CommandParameter="5"
                                    ui:Seg.IsOn="{Binding Selected.MemoryPriority, Converter={StaticResource EqualsParameter}, ConverterParameter=5, Mode=OneWay}"/>
                        </UniformGrid>

                        <TextBlock Text="CONTROL" Style="{StaticResource Text.Label}" Margin="0,22,0,8"/>
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource Btn.Outline}" Content="CPU CAP…" Command="{Binding EditCpuLimitCommand}" Margin="0,0,4,8"/>
                            <Button Style="{StaticResource Btn.Outline}" Content="CORES…" Command="{Binding EditAffinityCommand}" Margin="4,0,0,8"/>
                            <Button Command="{Binding ToggleEfficiencyCommand}" Margin="0,0,4,8">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Btn.Outline}">
                                        <Setter Property="Content" Value="ECO MODE"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Selected.IsEfficiencyMode}" Value="True">
                                                <Setter Property="Content" Value="ECO ✓"/>
                                                <Setter Property="Background" Value="{StaticResource VoltBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{StaticResource Btn.Outline}" Content="TRIM RAM" Command="{Binding TrimCommand}" Margin="4,0,0,8"/>
                            <Button Command="{Binding ToggleSuspendCommand}" Margin="0,0,4,8">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Btn.Outline}">
                                        <Setter Property="Content" Value="PAUSE"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Selected.IsSuspended}" Value="True">
                                                <Setter Property="Content" Value="RESUME"/>
                                                <Setter Property="Background" Value="{StaticResource VoltBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{StaticResource Btn.Outline}" Content="MAKE RULE" Command="{Binding MakeRuleCommand}" Margin="4,0,0,8"/>
                        </UniformGrid>

                        <Button Style="{StaticResource Btn.Solid}" Content="END PROCESS" Command="{Binding EndCommand}" Margin="0,14,0,8" Padding="18,14" FontSize="15"/>
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource Btn.Ghost}" Content="END TREE" Command="{Binding EndTreeCommand}"/>
                            <Button Style="{StaticResource Btn.Ghost}" Content="OPEN FOLDER" Command="{Binding OpenLocationCommand}"/>
                        </UniformGrid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
