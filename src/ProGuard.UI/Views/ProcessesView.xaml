<UserControl x:Class="ProGuard.UI.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:r="clr-namespace:ProGuard.UI.Resources"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ProGuard.UI.Controls"
             xmlns:vm="clr-namespace:ProGuard.UI.ViewModels">
    <UserControl.Resources>
        <!-- Column widths shared by the header and every row. -->
        <GridLength x:Key="ColIcon">34</GridLength>
        <GridLength x:Key="ColPid">66</GridLength>
        <GridLength x:Key="ColCpu">132</GridLength>
        <GridLength x:Key="ColMem">86</GridLength>
        <GridLength x:Key="ColPri">80</GridLength>
        <GridLength x:Key="ColCores">52</GridLength>

        <!-- A sortable column header: shows ▼ and full strength when it is the active sort. -->
        <Style x:Key="SortHeader" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
            <Setter Property="Padding" Value="0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Opacity" Value="0.55"/>
            <Style.Triggers>
                <Trigger Property="ui:Seg.IsOn" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <ContextMenu x:Key="RowMenu" Opened="OnMenuOpened" Closed="OnMenuClosed">
            <MenuItem Header="{x:Static r:Strings.Priority}">
                <MenuItem Header="{x:Static r:Strings.Realtime}" Command="{Binding SetPriorityCommand}" CommandParameter="RealTime"
                          IsChecked="{Binding Selected.Priority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=RealTime}"/>
                <MenuItem Header="{x:Static r:Strings.High}" Command="{Binding SetPriorityCommand}" CommandParameter="High"
                          IsChecked="{Binding Selected.Priority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=High}"/>
                <MenuItem Header="{x:Static r:Strings.AboveNormal}" Command="{Binding SetPriorityCommand}" CommandParameter="AboveNormal"
                          IsChecked="{Binding Selected.Priority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=AboveNormal}"/>
                <MenuItem Header="{x:Static r:Strings.Normal}" Command="{Binding SetPriorityCommand}" CommandParameter="Normal"
                          IsChecked="{Binding Selected.Priority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=Normal}"/>
                <MenuItem Header="{x:Static r:Strings.BelowNormal}" Command="{Binding SetPriorityCommand}" CommandParameter="BelowNormal"
                          IsChecked="{Binding Selected.Priority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=BelowNormal}"/>
                <MenuItem Header="{x:Static r:Strings.Idle}" Command="{Binding SetPriorityCommand}" CommandParameter="Idle"
                          IsChecked="{Binding Selected.Priority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=Idle}"/>
                <Separator Style="{StaticResource Menu.Separator}"/>
                <MenuItem Header="{x:Static r:Strings.Always}" AutomationProperties.Name="Always priority">
                    <MenuItem Header="{x:Static r:Strings.Realtime}" Command="{Binding AlwaysPriorityCommand}" CommandParameter="RealTime"
                              IsChecked="{Binding SelectedRule.PriorityClass, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=256}"/>
                    <MenuItem Header="{x:Static r:Strings.High}" Command="{Binding AlwaysPriorityCommand}" CommandParameter="High"
                              IsChecked="{Binding SelectedRule.PriorityClass, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=128}"/>
                    <MenuItem Header="{x:Static r:Strings.AboveNormal}" Command="{Binding AlwaysPriorityCommand}" CommandParameter="AboveNormal"
                              IsChecked="{Binding SelectedRule.PriorityClass, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=32768}"/>
                    <MenuItem Header="{x:Static r:Strings.Normal}" Command="{Binding AlwaysPriorityCommand}" CommandParameter="Normal"
                              IsChecked="{Binding SelectedRule.PriorityClass, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=32}"/>
                    <MenuItem Header="{x:Static r:Strings.BelowNormal}" Command="{Binding AlwaysPriorityCommand}" CommandParameter="BelowNormal"
                              IsChecked="{Binding SelectedRule.PriorityClass, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=16384}"/>
                    <MenuItem Header="{x:Static r:Strings.Idle}" Command="{Binding AlwaysPriorityCommand}" CommandParameter="Idle"
                              IsChecked="{Binding SelectedRule.PriorityClass, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=64}"/>
                    <Separator Style="{StaticResource Menu.Separator}"/>
                    <MenuItem Header="{x:Static r:Strings.Forget}" Command="{Binding AlwaysPriorityCommand}" CommandParameter="Forget"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{x:Static r:Strings.IOPriority}">
                <MenuItem Header="{x:Static r:Strings.HighAdministrator}" Command="{Binding SetIoPriorityCommand}" CommandParameter="3"
                          IsChecked="{Binding Selected.IoPriority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=3}"/>
                <MenuItem Header="{x:Static r:Strings.Normal}" Command="{Binding SetIoPriorityCommand}" CommandParameter="2"
                          IsChecked="{Binding Selected.IoPriority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=2}"/>
                <MenuItem Header="{x:Static r:Strings.Low}" Command="{Binding SetIoPriorityCommand}" CommandParameter="1"
                          IsChecked="{Binding Selected.IoPriority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=1}"/>
                <MenuItem Header="{x:Static r:Strings.VeryLow}" Command="{Binding SetIoPriorityCommand}" CommandParameter="0"
                          IsChecked="{Binding Selected.IoPriority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=0}"/>
                <Separator Style="{StaticResource Menu.Separator}"/>
                <MenuItem Header="{x:Static r:Strings.Always}" AutomationProperties.Name="Always I/O priority">
                    <MenuItem Header="{x:Static r:Strings.HighAdministrator}" Command="{Binding AlwaysIoPriorityCommand}" CommandParameter="3"
                              IsChecked="{Binding SelectedRule.IoPriority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=3}"/>
                    <MenuItem Header="{x:Static r:Strings.Normal}" Command="{Binding AlwaysIoPriorityCommand}" CommandParameter="2"
                              IsChecked="{Binding SelectedRule.IoPriority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=2}"/>
                    <MenuItem Header="{x:Static r:Strings.Low}" Command="{Binding AlwaysIoPriorityCommand}" CommandParameter="1"
                              IsChecked="{Binding SelectedRule.IoPriority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=1}"/>
                    <MenuItem Header="{x:Static r:Strings.VeryLow}" Command="{Binding AlwaysIoPriorityCommand}" CommandParameter="0"
                              IsChecked="{Binding SelectedRule.IoPriority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=0}"/>
                    <Separator Style="{StaticResource Menu.Separator}"/>
                    <MenuItem Header="{x:Static r:Strings.Forget}" Command="{Binding AlwaysIoPriorityCommand}" CommandParameter="Forget"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{x:Static r:Strings.MemoryPriority}">
                <MenuItem Header="{x:Static r:Strings.Normal}" Command="{Binding SetMemoryPriorityCommand}" CommandParameter="5"
                          IsChecked="{Binding Selected.MemoryPriority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=5}"/>
                <MenuItem Header="{x:Static r:Strings.BelowNormal}" Command="{Binding SetMemoryPriorityCommand}" CommandParameter="4"
                          IsChecked="{Binding Selected.MemoryPriority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=4}"/>
                <MenuItem Header="{x:Static r:Strings.Medium}" Command="{Binding SetMemoryPriorityCommand}" CommandParameter="3"
                          IsChecked="{Binding Selected.MemoryPriority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=3}"/>
                <MenuItem Header="{x:Static r:Strings.Low}" Command="{Binding SetMemoryPriorityCommand}" CommandParameter="2"
                          IsChecked="{Binding Selected.MemoryPriority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=2}"/>
                <MenuItem Header="{x:Static r:Strings.VeryLow}" Command="{Binding SetMemoryPriorityCommand}" CommandParameter="1"
                          IsChecked="{Binding Selected.MemoryPriority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=1}"/>
                <Separator Style="{StaticResource Menu.Separator}"/>
                <MenuItem Header="{x:Static r:Strings.Always}" AutomationProperties.Name="Always memory priority">
                    <MenuItem Header="{x:Static r:Strings.Normal}" Command="{Binding AlwaysMemoryPriorityCommand}" CommandParameter="5"
                              IsChecked="{Binding SelectedRule.MemoryPriority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=5}"/>
                    <MenuItem Header="{x:Static r:Strings.BelowNormal}" Command="{Binding AlwaysMemoryPriorityCommand}" CommandParameter="4"
                              IsChecked="{Binding SelectedRule.MemoryPriority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=4}"/>
                    <MenuItem Header="{x:Static r:Strings.Medium}" Command="{Binding AlwaysMemoryPriorityCommand}" CommandParameter="3"
                              IsChecked="{Binding SelectedRule.MemoryPriority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=3}"/>
                    <MenuItem Header="{x:Static r:Strings.Low}" Command="{Binding AlwaysMemoryPriorityCommand}" CommandParameter="2"
                              IsChecked="{Binding SelectedRule.MemoryPriority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=2}"/>
                    <MenuItem Header="{x:Static r:Strings.VeryLow}" Command="{Binding AlwaysMemoryPriorityCommand}" CommandParameter="1"
                              IsChecked="{Binding SelectedRule.MemoryPriority, Mode=OneWay, Converter={StaticResource EqualsParameter}, ConverterParameter=1}"/>
                    <Separator Style="{StaticResource Menu.Separator}"/>
                    <MenuItem Header="{x:Static r:Strings.Forget}" Command="{Binding AlwaysMemoryPriorityCommand}" CommandParameter="Forget"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{x:Static r:Strings.CpuCap2}" Command="{Binding EditCpuLimitCommand}"/>
            <MenuItem Header="{x:Static r:Strings.Cores2}" Command="{Binding EditAffinityCommand}"/>
            <MenuItem Header="{x:Static r:Strings.EfficiencyMode}" Command="{Binding ToggleEfficiencyCommand}" IsChecked="{Binding Selected.IsEfficiencyMode, Mode=OneWay}"/>
            <Separator Style="{StaticResource Menu.Separator}"/>
            <MenuItem Header="{x:Static r:Strings.TrimMemory}" Command="{Binding TrimCommand}"/>
            <MenuItem Command="{Binding ToggleSuspendCommand}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{x:Static r:Strings.Pause}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Selected.IsSuspended}" Value="True">
                                <Setter Property="Header" Value="{x:Static r:Strings.Resume}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <Separator Style="{StaticResource Menu.Separator}"/>
            <MenuItem Header="{x:Static r:Strings.MakeARule}" Command="{Binding MakeRuleCommand}"/>
            <MenuItem Header="{x:Static r:Strings.OpenFileLocation}" Command="{Binding OpenLocationCommand}"/>
            <Separator Style="{StaticResource Menu.Separator}"/>
            <MenuItem Header="{x:Static r:Strings.EndProcess}" Command="{Binding EndCommand}" InputGestureText="DEL"/>
            <MenuItem Header="{x:Static r:Strings.EndProcessTree}" Command="{Binding EndTreeCommand}"/>
        </ContextMenu>

        <DataTemplate x:Key="RowTemplate" DataType="{x:Type vm:ProcessRow}">
            <Grid Height="40" Margin="12,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource ColIcon}"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource ColPid}"/>
                    <ColumnDefinition Width="{StaticResource ColCpu}"/>
                    <ColumnDefinition Width="{StaticResource ColMem}"/>
                    <ColumnDefinition Width="{StaticResource ColPri}"/>
                    <ColumnDefinition Width="{StaticResource ColCores}"/>
                </Grid.ColumnDefinitions>

                <!-- Icon, or a monogram block until (or unless) one loads. -->
                <Grid Width="22" Height="22" HorizontalAlignment="Left">
                    <Border BorderBrush="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" BorderThickness="1.5"
                            Visibility="{Binding Icon, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}">
                        <TextBlock Text="{Binding Monogram}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>

                <DockPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,12,0">
                        <Border Style="{StaticResource Tag}" Visibility="{Binding LimitText, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="{Binding LimitText}" Style="{StaticResource Tag.Text}"/>
                        </Border>
                        <Border Style="{StaticResource Tag}" Visibility="{Binding IsSuspended, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="{x:Static r:Strings.Paused2}" Style="{StaticResource Tag.Text}"/>
                        </Border>
                        <Border Style="{StaticResource Tag}" Visibility="{Binding IsEfficiencyMode, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="{x:Static r:Strings.Eco2}" Style="{StaticResource Tag.Text}"/>
                        </Border>
                        <Border Style="{StaticResource Tag}" Visibility="{Binding IsRestrained, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="{x:Static r:Strings.Balanced}" Style="{StaticResource Tag.Text}"/>
                        </Border>
                        <Border Style="{StaticResource Tag}" Visibility="{Binding IsAffinityLimited, Converter={StaticResource VisibleWhen}}"
                                ToolTip="{x:Static r:Strings.TheCpuLimiterHasTakenCores}">
                            <TextBlock Text="{x:Static r:Strings.CoresLimited}" Style="{StaticResource Tag.Text}"/>
                        </Border>
                        <Border Style="{StaticResource Tag}" Visibility="{Binding HasRule, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="{x:Static r:Strings.Rule}" Style="{StaticResource Tag.Text}"/>
                        </Border>
                        <Border Style="{StaticResource Tag}" Opacity="0.55" Visibility="{Binding IsSystem, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="{x:Static r:Strings.Sys}" Style="{StaticResource Tag.Text}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{x:Static r:Strings.Focus}" DockPanel.Dock="Right" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"
                               Visibility="{Binding IsForeground, Converter={StaticResource VisibleWhen}}"/>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>

                <TextBlock Grid.Column="2" Text="{Binding Pid}" FontFamily="{StaticResource Mono}" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>

                <Grid Grid.Column="3" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CpuText}" FontFamily="{StaticResource Mono}" FontSize="13" FontWeight="Bold"/>
                    <ui:BlockMeter Grid.Column="1" Value="{Binding CpuPercent}"
                                   Maximum="{Binding DataContext.CpuScale, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                   Blocks="10" Height="10" Gap="2"/>
                </Grid>

                <TextBlock Grid.Column="4" Text="{Binding MemoryText}" FontFamily="{StaticResource Mono}" FontSize="12.5" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="5" Text="{Binding PriorityText}" FontWeight="Bold" FontStretch="SemiCondensed" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="6" Text="{Binding AffinityText}" FontFamily="{StaticResource Mono}" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>

            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ heading -->
        <DockPanel Grid.ColumnSpan="2">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,6">
                <StackPanel Margin="0,0,30,0">
                    <TextBlock Text="{x:Static r:Strings.Shown}" Style="{StaticResource Text.Label}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding ShownCount}" FontFamily="{StaticResource Mono}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{x:Static r:Strings.TotalCpu}" Style="{StaticResource Text.Label}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding TotalCpuText, StringFormat='{}{0}%'}" FontFamily="{StaticResource Mono}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{x:Static r:Strings.Processes}" Style="{StaticResource Text.Title}"/>
                <TextBlock Text="{Binding TotalCount}" FontFamily="{StaticResource Mono}" FontSize="15" FontWeight="Bold" Opacity="0.5"
                           VerticalAlignment="Top" Margin="10,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ============================================================ search + filters -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,20,0,16">
            <Grid DockPanel.Dock="Left" Width="300" Margin="0,0,26,0">
                <TextBox x:Name="SearchBox" AutomationProperties.Name="SEARCH NAME OR PID" Style="{StaticResource Field}" Tag="{x:Static r:Strings.SearchNameOrPid}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Style="{StaticResource Btn.Ghost}" Content="&#xE711;" FontFamily="{StaticResource Glyphs}" FontWeight="Normal" FontSize="10"
                        HorizontalAlignment="Right" Padding="8" Command="{Binding ClearSearchCommand}" ToolTip="{x:Static r:Strings.Clear}"
                        Visibility="{Binding Search, Converter={StaticResource VisibleWhen}}"/>
            </Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource Chip.Radio}" Content="{x:Static r:Strings.All}" GroupName="pf"
                             IsChecked="{Binding Filter, Converter={StaticResource EqualsParameter}, ConverterParameter=All}"/>
                <RadioButton Style="{StaticResource Chip.Radio}" Content="{x:Static r:Strings.Apps}" GroupName="pf" ToolTip="{x:Static r:Strings.ProcessesInYourSession}"
                             IsChecked="{Binding Filter, Converter={StaticResource EqualsParameter}, ConverterParameter=Apps}"/>
                <RadioButton Style="{StaticResource Chip.Radio}" Content="{x:Static r:Strings.System}" GroupName="pf" ToolTip="{x:Static r:Strings.ServicesAndWindowsItself}"
                             IsChecked="{Binding Filter, Converter={StaticResource EqualsParameter}, ConverterParameter=System}"/>
                <RadioButton Style="{StaticResource Chip.Radio}" Content="{x:Static r:Strings.Active}" GroupName="pf" ToolTip="{x:Static r:Strings.UsingAnyCpuRightNow}"
                             IsChecked="{Binding Filter, Converter={StaticResource EqualsParameter}, ConverterParameter=Active}"/>
                <RadioButton Style="{StaticResource Chip.Radio}" Content="{x:Static r:Strings.Heavy}" GroupName="pf" ToolTip="{x:Static r:Strings.Using500MbOrMore}"
                             IsChecked="{Binding Filter, Converter={StaticResource EqualsParameter}, ConverterParameter=Heavy}"/>
            </StackPanel>
        </DockPanel>

        <!-- ============================================================ column header -->
        <Border Grid.Row="2" BorderBrush="{StaticResource VoltBrush}" BorderThickness="0,0,0,2">
            <Grid Margin="12,0,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource ColIcon}"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource ColPid}"/>
                    <ColumnDefinition Width="{StaticResource ColCpu}"/>
                    <ColumnDefinition Width="{StaticResource ColMem}"/>
                    <ColumnDefinition Width="{StaticResource ColPri}"/>
                    <ColumnDefinition Width="{StaticResource ColCores}"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Style="{StaticResource SortHeader}" Content="{x:Static r:Strings.Name}" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProcessSort.Name}"
                        ui:Seg.IsOn="{Binding Sort, Converter={StaticResource EqualsParameter}, ConverterParameter=Name, Mode=OneWay}"/>
                <Button Grid.Column="2" Style="{StaticResource SortHeader}" Content="{x:Static r:Strings.Pid}" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProcessSort.Pid}"
                        ui:Seg.IsOn="{Binding Sort, Converter={StaticResource EqualsParameter}, ConverterParameter=Pid, Mode=OneWay}"/>
                <Button Grid.Column="3" Style="{StaticResource SortHeader}" Content="{x:Static r:Strings.Cpu2}" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProcessSort.Cpu}"
                        ui:Seg.IsOn="{Binding Sort, Converter={StaticResource EqualsParameter}, ConverterParameter=Cpu, Mode=OneWay}"/>
                <Button Grid.Column="4" Style="{StaticResource SortHeader}" Content="{x:Static r:Strings.Memory2}" Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProcessSort.Memory}"
                        ui:Seg.IsOn="{Binding Sort, Converter={StaticResource EqualsParameter}, ConverterParameter=Memory, Mode=OneWay}"/>
                <TextBlock Grid.Column="5" Text="{x:Static r:Strings.Priority2}" Style="{StaticResource Text.Label}" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="6" Text="{x:Static r:Strings.Cores}" Style="{StaticResource Text.Label}" FontWeight="Bold" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ============================================================ table -->
        <ListBox x:Name="Table" AutomationProperties.AutomationId="ProcessTable" Grid.Row="3" Style="{StaticResource Table}" ItemContainerStyle="{StaticResource Table.Row}"
                 ItemTemplate="{StaticResource RowTemplate}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                 ContextMenu="{StaticResource RowMenu}"
                 MouseEnter="OnTableMouseEnter" MouseLeave="OnTableMouseLeave"
                 PreviewMouseRightButtonDown="OnTableRightButtonDown" KeyDown="OnTableKeyDown"/>

        <!-- ============================================================ inspector -->
        <Border Grid.Column="1" Grid.Row="2" Grid.RowSpan="2" Width="320" Margin="24,0,0,0" BorderBrush="{StaticResource VoltBrush}" BorderThickness="2"
                Visibility="{Binding Selected, Converter={StaticResource VisibleWhen}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{StaticResource VoltBrush}" Padding="20,16">
                        <StackPanel TextElement.Foreground="{StaticResource InkBrush}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Selected.Pid, StringFormat={x:Static r:Strings.Pid0}}" FontFamily="{StaticResource Mono}" FontSize="11" FontWeight="Bold"/>
                                <TextBlock Text="{x:Static r:Strings.Selected}" FontSize="11" FontWeight="SemiBold" Opacity="0.7"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Selected.Name}" FontWeight="Bold" FontStretch="Condensed" FontSize="30" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Selected.Path}" FontFamily="{StaticResource Mono}" FontSize="10" Opacity="0.7" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Selected.Path}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="20,18,20,22">
                        <UniformGrid Columns="2">
                            <StackPanel>
                                <TextBlock Text="{x:Static r:Strings.Cpu3}" Style="{StaticResource Text.Label}"/>
                                <TextBlock Text="{Binding Selected.CpuText, StringFormat='{}{0}%'}" FontWeight="Bold" FontStretch="Condensed" FontSize="40"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{x:Static r:Strings.Memory}" Style="{StaticResource Text.Label}"/>
                                <TextBlock Text="{Binding Selected.MemoryText}" FontWeight="Bold" FontStretch="Condensed" FontSize="40"/>
                            </StackPanel>
                        </UniformGrid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{x:Static r:Strings.Started}" Style="{StaticResource Text.Label}" Margin="0,3,16,3"/>
                            <TextBlock Grid.Column="1" Text="{Binding Selected.StartedText}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Text="{x:Static r:Strings.Parent}" Style="{StaticResource Text.Label}" Margin="0,3,16,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.ParentPid}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,3"/>
                            <TextBlock Grid.Row="2" Text="{x:Static r:Strings.Cores}" Style="{StaticResource Text.Label}" Margin="0,3,16,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Selected.AffinityText}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,3"/>
                            <TextBlock Grid.Row="3" Text="{x:Static r:Strings.User}" Style="{StaticResource Text.Label}" Margin="0,3,16,3"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Selected.UserText}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,3"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Selected.UserText}"/>
                            <TextBlock Grid.Row="4" Text="{x:Static r:Strings.Session}" Style="{StaticResource Text.Label}" Margin="0,3,16,3"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Selected.SessionId}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,3"/>
                            <TextBlock Grid.Row="5" Text="{x:Static r:Strings.Private}" Style="{StaticResource Text.Label}" Margin="0,3,16,3"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Selected.PrivateText}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,3"/>
                            <TextBlock Grid.Row="6" Text="{x:Static r:Strings.Threads}" Style="{StaticResource Text.Label}" Margin="0,3,16,3"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Selected.ThreadCount}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,3"/>
                            <TextBlock Grid.Row="7" Text="{x:Static r:Strings.IOPriority2}" Style="{StaticResource Text.Label}" Margin="0,3,16,3"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Selected.IoPriorityText}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,3"/>
                            <TextBlock Grid.Row="8" Text="{x:Static r:Strings.MemoryPri}" Style="{StaticResource Text.Label}" Margin="0,3,16,3"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Selected.MemoryPriorityText}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="0,3"/>
                        </Grid>

                        <TextBlock Text="{x:Static r:Strings.Priority2}" Style="{StaticResource Text.Label}" Margin="0,22,0,8"/>
                        <UniformGrid Columns="5">
                            <Button Style="{StaticResource Seg}" Content="{x:Static r:Strings.Idle2}" AutomationProperties.Name="PRIORITY IDLE" Command="{Binding SetPriorityCommand}" CommandParameter="Idle"
                                    ui:Seg.IsOn="{Binding Selected.Priority, Converter={StaticResource EqualsParameter}, ConverterParameter=Idle, Mode=OneWay}"/>
                            <Button Style="{StaticResource Seg}" Content="{x:Static r:Strings.Low2}" AutomationProperties.Name="PRIORITY BELOW NORMAL" Command="{Binding SetPriorityCommand}" CommandParameter="BelowNormal"
                                    ui:Seg.IsOn="{Binding Selected.Priority, Converter={StaticResource EqualsParameter}, ConverterParameter=BelowNormal, Mode=OneWay}"/>
                            <Button Style="{StaticResource Seg}" Content="{x:Static r:Strings.Norm}" AutomationProperties.Name="PRIORITY NORMAL" Command="{Binding SetPriorityCommand}" CommandParameter="Normal"
                                    ui:Seg.IsOn="{Binding Selected.Priority, Converter={StaticResource EqualsParameter}, ConverterParameter=Normal, Mode=OneWay}"/>
                            <Button Style="{StaticResource Seg}" Content="{x:Static r:Strings.Above}" AutomationProperties.Name="PRIORITY ABOVE NORMAL" Command="{Binding SetPriorityCommand}" CommandParameter="AboveNormal"
                                    ui:Seg.IsOn="{Binding Selected.Priority, Converter={StaticResource EqualsParameter}, ConverterParameter=AboveNormal, Mode=OneWay}"/>
                            <Button Style="{StaticResource Seg}" Content="{x:Static r:Strings.High2}" AutomationProperties.Name="PRIORITY HIGH" Command="{Binding SetPriorityCommand}" CommandParameter="High"
                                    ui:Seg.IsOn="{Binding Selected.Priority, Converter={StaticResource EqualsParameter}, ConverterParameter=High, Mode=OneWay}"/>
                        </UniformGrid>

                        <DockPanel Margin="0,22,0,8">
                            <TextBlock DockPanel.Dock="Right" Text="{x:Static r:Strings.HighNeedsAdmin}" FontFamily="{StaticResource Mono}" FontSize="9.5" Opacity="0.5"
                                       Visibility="{Binding IsAdministrator, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"/>
                            <TextBlock Text="{x:Static r:Strings.IOPriority2}" Style="{StaticResource Text.Label}"/>
                        </DockPanel>
                        <UniformGrid Columns="4">
                            <Button Style="{StaticResource Seg}" Content="{x:Static r:Strings.VLow}" AutomationProperties.Name="I/O VERY LOW" Command="{Binding SetIoPriorityCommand}" CommandParameter="0"
                                    ui:Seg.IsOn="{Binding Selected.IoPriority, Converter={StaticResource EqualsParameter}, ConverterParameter=0, Mode=OneWay}"/>
                            <Button Style="{StaticResource Seg}" Content="{x:Static r:Strings.Low2}" AutomationProperties.Name="I/O LOW" Command="{Binding SetIoPriorityCommand}" CommandParameter="1"
                                    ui:Seg.IsOn="{Binding Selected.IoPriority, Converter={StaticResource EqualsParameter}, ConverterParameter=1, Mode=OneWay}"/>
                            <Button Style="{StaticResource Seg}" Content="{x:Static r:Strings.Norm}" AutomationProperties.Name="I/O NORMAL" Command="{Binding SetIoPriorityCommand}" CommandParameter="2"
                                    ui:Seg.IsOn="{Binding Selected.IoPriority, Converter={StaticResource EqualsParameter}, ConverterParameter=2, Mode=OneWay}"/>
                            <Button Style="{StaticResource Seg}" Content="{x:Static r:Strings.High2}" AutomationProperties.Name="I/O HIGH" Command="{Binding SetIoPriorityCommand}" CommandParameter="3"
                                    ui:Seg.IsOn="{Binding Selected.IoPriority, Converter={StaticResource EqualsParameter}, ConverterParameter=3, Mode=OneWay}"/>
                        </UniformGrid>

                        <TextBlock Text="{x:Static r:Strings.MemoryPriority2}" Style="{StaticResource Text.Label}" Margin="0,22,0,8"/>
                        <UniformGrid Columns="5">
                            <Button Style="{StaticResource Seg}" Content="{x:Static r:Strings.VLow}" AutomationProperties.Name="MEMORY VERY LOW" Command="{Binding SetMemoryPriorityCommand}" CommandParameter="1"
                                    ui:Seg.IsOn="{Binding Selected.MemoryPriority, Converter={StaticResource EqualsParameter}, ConverterParameter=1, Mode=OneWay}"/>
                            <Button Style="{StaticResource Seg}" Content="{x:Static r:Strings.Low2}" AutomationProperties.Name="MEMORY LOW" Command="{Binding SetMemoryPriorityCommand}" CommandParameter="2"
                                    ui:Seg.IsOn="{Binding Selected.MemoryPriority, Converter={StaticResource EqualsParameter}, ConverterParameter=2, Mode=OneWay}"/>
                            <Button Style="{StaticResource Seg}" Content="{x:Static r:Strings.Med}" AutomationProperties.Name="MEMORY MEDIUM" Command="{Binding SetMemoryPriorityCommand}" CommandParameter="3"
                                    ui:Seg.IsOn="{Binding Selected.MemoryPriority, Converter={StaticResource EqualsParameter}, ConverterParameter=3, Mode=OneWay}"/>
                            <Button Style="{StaticResource Seg}" Content="{x:Static r:Strings.Below}" AutomationProperties.Name="MEMORY BELOW NORMAL" Command="{Binding SetMemoryPriorityCommand}" CommandParameter="4"
                                    ui:Seg.IsOn="{Binding Selected.MemoryPriority, Converter={StaticResource EqualsParameter}, ConverterParameter=4, Mode=OneWay}"/>
                            <Button Style="{StaticResource Seg}" Content="{x:Static r:Strings.Norm}" AutomationProperties.Name="MEMORY NORMAL" Command="{Binding SetMemoryPriorityCommand}" CommandParameter="5"
                                    ui:Seg.IsOn="{Binding Selected.MemoryPriority, Converter={StaticResource EqualsParameter}, ConverterParameter=5, Mode=OneWay}"/>
                        </UniformGrid>

                        <TextBlock Text="{x:Static r:Strings.Control}" Style="{StaticResource Text.Label}" Margin="0,22,0,8"/>
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource Btn.Outline}" Content="{x:Static r:Strings.CpuCap3}" Command="{Binding EditCpuLimitCommand}" Margin="0,0,4,8"/>
                            <Button Style="{StaticResource Btn.Outline}" Content="{x:Static r:Strings.Cores3}" Command="{Binding EditAffinityCommand}" Margin="4,0,0,8"/>
                            <Button Command="{Binding ToggleEfficiencyCommand}" Margin="0,0,4,8">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Btn.Outline}">
                                        <Setter Property="Content" Value="{x:Static r:Strings.EcoMode}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Selected.IsEfficiencyMode}" Value="True">
                                                <Setter Property="Content" Value="{x:Static r:Strings.Eco}"/>
                                                <Setter Property="Background" Value="{StaticResource VoltBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{StaticResource Btn.Outline}" Content="{x:Static r:Strings.TrimRam}" Command="{Binding TrimCommand}" Margin="4,0,0,8"/>
                            <Button Command="{Binding ToggleSuspendCommand}" Margin="0,0,4,8">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource Btn.Outline}">
                                        <Setter Property="Content" Value="{x:Static r:Strings.Pause2}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Selected.IsSuspended}" Value="True">
                                                <Setter Property="Content" Value="{x:Static r:Strings.Resume2}"/>
                                                <Setter Property="Background" Value="{StaticResource VoltBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Style="{StaticResource Btn.Outline}" Content="{x:Static r:Strings.MakeRule}" Command="{Binding MakeRuleCommand}" Margin="4,0,0,8"/>
                        </UniformGrid>

                        <Button Style="{StaticResource Btn.Solid}" Content="{x:Static r:Strings.EndProcess2}" Command="{Binding EndCommand}" Margin="0,14,0,8" Padding="18,14" FontSize="15"/>
                        <UniformGrid Columns="2">
                            <Button Style="{StaticResource Btn.Ghost}" Content="{x:Static r:Strings.EndTree}" Command="{Binding EndTreeCommand}"/>
                            <Button Style="{StaticResource Btn.Ghost}" Content="{x:Static r:Strings.OpenFolder}" Command="{Binding OpenLocationCommand}"/>
                        </UniformGrid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
