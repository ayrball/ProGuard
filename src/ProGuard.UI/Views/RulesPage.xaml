<Page x:Class="ProGuard.UI.Views.RulesPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
         Title="Rules">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <ui:Button Icon="{ui:SymbolIcon Symbol=Add24}" Content="Add Rule" Appearance="Primary" Command="{Binding AddRuleCommand}" Margin="0,0,10,0"/>
            <ui:Button Icon="{ui:SymbolIcon Symbol=Delete24}" Content="Delete Selected" Appearance="Danger" Command="{Binding DeleteRuleCommand}"/>
        </StackPanel>

        <!-- Inline Add Rule Panel -->
        <ui:CardControl Grid.Row="1" Margin="0,0,0,16" Visibility="{Binding IsAddPanelOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Margin="8">
                <TextBlock Text="Add Persistent Process Rule" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,16"/>

                <WrapPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,16,12">
                        <TextBlock Text="Process Name:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                        <ui:TextBox Text="{Binding NewProcessName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. obs64.exe" Width="180"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,16,12">
                        <TextBlock Text="Priority:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                        <ComboBox SelectedValue="{Binding NewPriority}" SelectedValuePath="Content" Width="150">
                            <ComboBoxItem Content="RealTime"/>
                            <ComboBoxItem Content="High"/>
                            <ComboBoxItem Content="AboveNormal"/>
                            <ComboBoxItem Content="Normal" IsSelected="True"/>
                            <ComboBoxItem Content="BelowNormal"/>
                            <ComboBoxItem Content="Idle"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,16,12">
                        <TextBlock Text="CPU Limit (%):" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                        <ui:TextBox Text="{Binding NewCpuLimit, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. 50 or None" Width="130"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,16,12" ToolTip="CPU Limiter: when the process uses at least this much CPU for the given time, remove cores from its affinity for a while, then restore it. Leave the threshold blank for no limit.">
                        <TextBlock Text="CPU Limiter (affinity):" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="≥" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ui:TextBox Text="{Binding NewCpuLimitThreshold, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="%" Width="70"/>
                            <TextBlock Text="% for" VerticalAlignment="Center" Margin="4,0"/>
                            <ui:TextBox Text="{Binding NewCpuLimitOverSeconds, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <TextBlock Text="s, remove" VerticalAlignment="Center" Margin="4,0"/>
                            <ui:TextBox Text="{Binding NewCpuLimitCores, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <TextBlock Text="cores for" VerticalAlignment="Center" Margin="4,0"/>
                            <ui:TextBox Text="{Binding NewCpuLimitDuration, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <TextBlock Text="s" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,0,20,12" VerticalAlignment="Bottom">
                        <CheckBox IsChecked="{Binding NewIsDisallowed}" Content="Disallow Execution" Margin="0,0,0,6"/>
                    </StackPanel>

                </WrapPanel>

                <!-- Instance limit, Instance Balancer and startup boost -->
                <WrapPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,16,12">
                        <TextBlock Text="Max Instances:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                        <ui:TextBox Text="{Binding NewMaxInstances, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. 2 or None" Width="110"
                                    ToolTip="Newer instances over this count are terminated"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,20,12" VerticalAlignment="Bottom">
                        <CheckBox IsChecked="{Binding NewMaxInstancesAllSessions}" Content="Count all sessions" Margin="0,0,0,6"
                                  ToolTip="Count instances of every user instead of only the new instance's session"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,16,12">
                        <TextBlock Text="Instance Balancer:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding BalancerModes}" SelectedItem="{Binding NewBalancerMode}" Width="200"
                                  ToolTip="Split the CPU cores across the running instances"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,16,12">
                        <TextBlock Text="Cores / Instance:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                        <ui:TextBox Text="{Binding NewBalancerCoresPerInstance, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                    ToolTip="Used by 'Fixed cores per instance'"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,16,12">
                        <TextBlock Text="Reserve Cores:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                        <ui:TextBox Text="{Binding NewBalancerReservedCores, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                    ToolTip="The lowest cores are never given to an instance"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,16,12">
                        <TextBlock Text="Min CPU (%):" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                        <ui:TextBox Text="{Binding NewBalancerMinCpu, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                    ToolTip="An instance gets its own cores once it uses this much CPU"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,20,12" VerticalAlignment="Bottom">
                        <CheckBox IsChecked="{Binding NewBalancerAvoidSmt}" Content="Avoid SMT siblings" Margin="0,0,0,6"
                                  ToolTip="Use only the first logical processor of each physical core"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,16,12">
                        <TextBlock Text="Startup Boost:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                        <ComboBox SelectedValue="{Binding NewStartupBoostPriority}" SelectedValuePath="Content" Width="150"
                                  ToolTip="Priority class for the first seconds after the process starts">
                            <ComboBoxItem Content="None" IsSelected="True"/>
                            <ComboBoxItem Content="RealTime"/>
                            <ComboBoxItem Content="High"/>
                            <ComboBoxItem Content="AboveNormal"/>
                            <ComboBoxItem Content="Normal"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="0,0,16,12">
                        <TextBlock Text="Boost For (s):" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                        <ui:TextBox Text="{Binding NewStartupBoostSeconds, UpdateSourceTrigger=PropertyChanged}" Width="90"
                                    ToolTip="1 to 3600 seconds"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,12">
                        <ui:Button Content="Save Rule" Appearance="Primary" Command="{Binding SaveNewRuleCommand}" Margin="0,0,8,0"/>
                        <ui:Button Content="Cancel" Command="{Binding CancelAddRuleCommand}"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </ui:CardControl>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                  RowHeight="38" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Process Name" Binding="{Binding ProcessName}" Width="2*" MinWidth="180" ElementStyle="{StaticResource FluentDataGridTextStyle}"/>
                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="130" ElementStyle="{StaticResource FluentDataGridTextStyle}"/>
                <DataGridTextColumn Header="Affinity" Binding="{Binding Affinity}" Width="120" ElementStyle="{StaticResource FluentDataGridTextStyle}"/>
                <DataGridTextColumn Header="CPU Limit" Binding="{Binding CpuLimit}" Width="120" ElementStyle="{StaticResource FluentDataGridTextStyle}"/>
                <DataGridTextColumn Header="CPU Limiter (affinity)" Binding="{Binding CpuAffinityLimit}" Width="220" ElementStyle="{StaticResource FluentDataGridTextStyle}"/>
                <DataGridTextColumn Header="Max Instances" Binding="{Binding MaxInstances}" Width="130" ElementStyle="{StaticResource FluentDataGridTextStyle}"/>
                <DataGridTextColumn Header="Instance Balancer" Binding="{Binding InstanceBalancer}" Width="140" ElementStyle="{StaticResource FluentDataGridTextStyle}"/>
                <DataGridTextColumn Header="Startup Boost" Binding="{Binding StartupBoost}" Width="140" ElementStyle="{StaticResource FluentDataGridTextStyle}"/>
                <DataGridCheckBoxColumn Header="Disallowed" Binding="{Binding IsDisallowed}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
