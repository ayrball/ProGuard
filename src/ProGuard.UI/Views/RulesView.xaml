<UserControl x:Class="ProGuard.UI.Views.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,24">
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Solid}" Content="+ NEW RULE" Command="{Binding NewCommand}" VerticalAlignment="Bottom"/>
            <StackPanel>
                <TextBlock Text="RULES" Style="{StaticResource Text.Title}"/>
                <TextBlock Text="STANDING ORDERS, APPLIED EVERY TIME A PROGRAM STARTS" Style="{StaticResource Text.Label}" Margin="0,6,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ============================================================ list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource VoltLineBrush}" BorderThickness="0,0,0,2" Padding="0,16">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Btn.Outline}" Content="EDIT" Margin="0,0,8,0" Padding="16,8"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource Btn.Ghost}" Content="&#xE74D;" FontFamily="{StaticResource Glyphs}" FontWeight="Normal" ToolTip="Delete rule"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H2}" FontSize="28"/>
                                    <ItemsControl ItemsSource="{Binding Effects}" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Tag}" Padding="7,3" Margin="0,0,6,4">
                                                    <TextBlock Text="{Binding}" Style="{StaticResource Tag.Text}" FontSize="10.5"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,80">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsLoaded}" Value="True"/>
                                <Condition Binding="{Binding Rules.Count}" Value="0"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="NO&#x0a;RULES&#x0a;YET." Style="{StaticResource Text.Hero}" FontSize="110" LineHeight="96" Opacity="0.2"/>
            <TextBlock Style="{StaticResource Text.Body}" FontSize="16" MaxWidth="460" HorizontalAlignment="Left" Margin="0,22,0,0" Opacity="0.75"
                       Text="Pin a program's priority, cap its CPU, keep it on certain cores, shield it from ProGuard's balancing, or stop it from running at all. Right-click any process and choose Make a rule, or start one here."/>
        </StackPanel>

        <!-- ============================================================ editor -->
        <Border Grid.Column="1" Grid.Row="1" Width="380" Margin="32,0,0,0" BorderBrush="{StaticResource VoltBrush}" BorderThickness="2"
                Visibility="{Binding Editor, Converter={StaticResource VisibleWhen}}">
            <DockPanel DataContext="{Binding Editor}">
                <Border DockPanel.Dock="Top" Background="{StaticResource VoltBrush}" Padding="20,14">
                    <TextBlock Text="{Binding Heading}" Foreground="{StaticResource InkBrush}" FontWeight="Bold" FontStretch="Condensed" FontSize="26"/>
                </Border>
                <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="20,0,20,20">
                    <Button Style="{StaticResource Btn.Ghost}" Content="CANCEL" Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Style="{StaticResource Btn.Solid}" Content="SAVE RULE" Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </UniformGrid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,18,20,18">
                        <TextBlock Text="PROGRAM" Style="{StaticResource Text.Label}"/>
                        <TextBox Style="{StaticResource Field}" Tag="e.g. chrome.exe" Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}" FontSize="20" FontWeight="Bold"/>

                        <TextBlock Text="PRIORITY" Style="{StaticResource Text.Label}" Margin="0,22,0,8"/>
                        <ListBox Style="{StaticResource Choices}" ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}"/>

                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding LimitEnabled}" Margin="0,18,0,0">
                            <TextBlock Text="CAP ITS CPU" FontWeight="Bold" FontSize="14"/>
                        </CheckBox>
                        <StackPanel Visibility="{Binding LimitEnabled, Converter={StaticResource VisibleWhen}}" Margin="0,10,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding LimitWhole, StringFormat='{}{0}%'}" FontFamily="{StaticResource Mono}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="OF THE WHOLE MACHINE" Style="{StaticResource Text.Label}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Slider Style="{StaticResource Slider}" Minimum="1" Maximum="99" Value="{Binding Limit}" SmallChange="1" LargeChange="5"/>
                        </StackPanel>

                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AffinityEnabled}" Margin="0,18,0,0">
                            <TextBlock Text="KEEP IT ON CERTAIN CORES" FontWeight="Bold" FontSize="14"/>
                        </CheckBox>
                        <ItemsControl ItemsSource="{Binding Cores}" Margin="0,10,0,0" Visibility="{Binding AffinityEnabled, Converter={StaticResource VisibleWhen}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding IsOn}" Content="{Binding Label}" Padding="0,6" Margin="0,0,4,4"
                                                  FontFamily="{StaticResource Mono}" FontSize="11"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ExcludeFromProBalance}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="NEVER BALANCE IT" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="ProBalance won't lower its priority, even under load." FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
                            </StackPanel>
                        </CheckBox>

                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding DisallowExecution}" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="BLOCK IT" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="Ended the moment it starts, including copies running now." FontSize="12" Opacity="0.6" TextWrapping="Wrap"/>
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
