<Page x:Class="ProGuard.UI.Views.SettingsPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
         Title="Settings">

    <ScrollViewer Margin="16">
        <StackPanel>
            <TextBlock Text="{Binding SaveError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="ProBalance Settings" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
            <ui:CardControl Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Enable ProBalance" VerticalAlignment="Center"/>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsProBalanceEnabled}" Content="Enabled"/>
                    </Grid>
                    
                    <TextBlock Text="Sensitivity:" Margin="0,0,0,4"/>
                    <Slider Minimum="1" Maximum="10" Value="{Binding Sensitivity, Mode=TwoWay}" TickPlacement="BottomRight" IsSnapToTickEnabled="True" Margin="0,0,0,16"/>

                    <TextBlock Text="CPU Threshold (%):" Margin="0,0,0,4"/>
                    <ui:NumberBox Value="{Binding CpuThreshold, Mode=TwoWay}" Margin="0,0,0,16" Minimum="10" Maximum="95"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Boost the foreground process to Above Normal" VerticalAlignment="Center"
                                   ToolTip="Process Lasso's foreground boosting. Off by default: it rarely helps."/>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsForegroundBoostEnabled, Mode=TwoWay}" Content="Enabled"/>
                    </Grid>
                </StackPanel>
            </ui:CardControl>

            <TextBlock Text="SmartTrim Settings" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
            <ui:CardControl Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Enable SmartTrim Working Set Optimization" VerticalAlignment="Center"/>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsSmartTrimEnabled, Mode=TwoWay}" Content="Enabled"/>
                    </Grid>

                    <TextBlock Text="Trim every (minutes):" Margin="0,0,0,4"/>
                    <ui:NumberBox Value="{Binding SmartTrimIntervalMinutes, Mode=TwoWay}" Margin="0,0,0,12" Minimum="1" Maximum="1440"/>

                    <TextBlock Text="Only when memory load is at least (%):" Margin="0,0,0,4"/>
                    <ui:NumberBox Value="{Binding SmartTrimMinimumRamLoadPercent, Mode=TwoWay}" Margin="0,0,0,12" Minimum="0" Maximum="100"/>

                    <TextBlock Text="Only processes using at least (MB):" Margin="0,0,0,4"/>
                    <ui:NumberBox Value="{Binding SmartTrimThresholdMb, Mode=TwoWay}" Margin="0,0,0,12" Minimum="1" Maximum="65536"/>

                    <TextBlock Text="Never trim these processes (comma separated):" Margin="0,0,0,4"/>
                    <ui:TextBox Text="{Binding SmartTrimExclusions, Mode=TwoWay}" PlaceholderText="e.g. obs64.exe, game.exe" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Purge standby list when free RAM is low" VerticalAlignment="Center"/>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsStandbyPurgeEnabled, Mode=TwoWay}" Content="Enabled"/>
                    </Grid>

                    <TextBlock Text="Free RAM threshold (MB):" Margin="0,0,0,4"/>
                    <ui:NumberBox Value="{Binding StandbyPurgeFreeRamThresholdMb, Mode=TwoWay}" Margin="0,0,0,12" Minimum="64" Maximum="65536"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Only purge automatically while Performance Mode is on" VerticalAlignment="Center"/>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding StandbyPurgeOnlyInPerformanceMode, Mode=TwoWay}" Content="Enabled"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Also purge the system file cache" VerticalAlignment="Center"/>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsFileCachePurgeEnabled, Mode=TwoWay}" Content="Enabled"/>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Log passes that take no action" VerticalAlignment="Center"/>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding SmartTrimLogNoAction, Mode=TwoWay}" Content="Enabled"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Content="Purge now" Command="{Binding PurgeNowCommand}"
                                   ToolTip="Trim working sets and purge the standby list now (requires administrator)"/>
                        <TextBlock Grid.Column="1" Text="{Binding PurgeResultText}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </StackPanel>
            </ui:CardControl>

            <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
            <ui:CardControl Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Theme:" Margin="0,0,0,4"/>
                    <ComboBox SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}" Width="200" HorizontalAlignment="Left" SelectionChanged="ThemeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Dark"/>
                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="System Default"/>
                    </ComboBox>
                </StackPanel>
            </ui:CardControl>

            <TextBlock Text="General &amp; Startup" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
            <ui:CardControl Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Start with Windows" VerticalAlignment="Center"/>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Content="Enabled"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Minimize to System Tray on Close" VerticalAlignment="Center"/>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" Content="Enabled"/>
                    </Grid>
                </StackPanel>
            </ui:CardControl>

            <TextBlock Text="About" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
            <ui:CardControl>
                <StackPanel>
                    <TextBlock Text="ProGuard" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Version 1.0.0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="A modern process management utility rivaling Process Lasso with ProBalance, Job Objects, and SmartTrim." TextWrapping="Wrap"/>
                </StackPanel>
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
