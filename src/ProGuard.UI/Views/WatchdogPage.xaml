<Page x:Class="ProGuard.UI.Views.WatchdogPage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
         xmlns:vm="clr-namespace:ProGuard.UI.ViewModels"
         Title="Watchdog">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <ui:Button Icon="{ui:SymbolIcon Symbol=Add24}" Content="New Watchdog Rule" Appearance="Primary" Command="{Binding AddRuleCommand}"/>
        </StackPanel>

        <!-- Inline Add Watchdog Rule Panel -->
        <ui:CardControl Grid.Row="1" Margin="0,0,0,16" Visibility="{Binding IsAddPanelOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Create New Watchdog Rule (IFTTT)" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>

                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Target Process:" Margin="0,0,0,4"/>
                        <ui:TextBox Text="{Binding NewProcessName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. miner.exe" Width="160"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Condition:" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{x:Static vm:WatchdogViewModel.ConditionOptions}" SelectedItem="{Binding NewCondition}" Width="180"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,8" Visibility="{Binding IsMemoryCondition, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Memory:" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{x:Static vm:WatchdogViewModel.MemoryMetricOptions}" SelectedItem="{Binding NewMemoryMetric}" Width="130"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Threshold:" Margin="0,0,0,4"/>
                        <ui:NumberBox Value="{Binding NewThreshold}" Width="100"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="For (s):" Margin="0,0,0,4" ToolTip="The condition must hold this long without a break"/>
                        <ui:NumberBox Value="{Binding NewDuration}" Width="90"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Text="Action:" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{x:Static vm:WatchdogViewModel.ActionOptions}" SelectedItem="{Binding NewAction}" Width="160"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,8" Visibility="{Binding ActionTakesArgument, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Value:" Margin="0,0,0,4"/>
                        <ui:TextBox Text="{Binding NewActionArgument, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{Binding ActionArgumentHint}" Width="220"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,8" Visibility="{Binding ActionTakesDuration, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Revert after (s):" Margin="0,0,0,4" ToolTip="0 keeps the change"/>
                        <ui:NumberBox Value="{Binding NewActionDuration}" Width="100"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,12,8" VerticalAlignment="Bottom" Visibility="{Binding IsTrimAction, Converter={StaticResource BoolToVisibilityConverter}}">
                        <CheckBox Content="Trim continuously" IsChecked="{Binding NewTrimContinuously}" ToolTip="Keep trimming every few seconds while the condition holds"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,16,8">
                        <TextBlock Text="Re-fire after (s):" Margin="0,0,0,4" ToolTip="If the condition is still true this long after firing, fire again. 0 waits until it clears."/>
                        <ui:NumberBox Value="{Binding NewCooldown}" Width="100"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <ui:Button Content="Save Rule" Appearance="Primary" Command="{Binding SaveNewRuleCommand}" Margin="0,0,8,0"/>
                        <ui:Button Content="Cancel" Command="{Binding CancelAddRuleCommand}"/>
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </ui:CardControl>

        <ListView Grid.Row="2" ItemsSource="{Binding WatchdogRules}" BorderThickness="0" Background="Transparent">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ui:CardControl Margin="0,0,0,8" HorizontalAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Description}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Details}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:ToggleSwitch IsChecked="{Binding IsEnabled, Mode=TwoWay}" Content="Enabled" Margin="0,0,16,0"/>
                                <ui:Button Icon="{ui:SymbolIcon Symbol=Delete24}" Appearance="Danger"
                                           Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                           CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Grid>
                    </ui:CardControl>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ui:CardControl Grid.Row="3" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Keep Running" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="Relaunched with their last command line whenever they exit (at most 5 times a minute)." Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:TextBox Text="{Binding NewKeepRunningName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. agent.exe" Width="200" Margin="0,0,8,0"/>
                    <ui:Button Icon="{ui:SymbolIcon Symbol=Add24}" Content="Add" Command="{Binding AddKeepRunningCommand}"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding KeepRunningProcesses}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" CornerRadius="4" Padding="8,2" Margin="0,0,8,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ui:Button Icon="{ui:SymbolIcon Symbol=Dismiss16}" Padding="4" ToolTip="Stop keeping this process running"
                                               Command="{Binding DataContext.RemoveKeepRunningCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Grid.Row="4" Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Recently Triggered Activity" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="1" Text="{Binding RecentTriggerText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </ui:CardControl>
    </Grid>
</Page>
