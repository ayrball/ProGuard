<UserControl x:Class="ProGuard.UI.Views.WatchdogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,24">
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Solid}" Content="+ NEW WATCH" Command="{Binding NewCommand}" VerticalAlignment="Bottom"/>
            <StackPanel>
                <TextBlock Text="WATCHDOG" Style="{StaticResource Text.Title}"/>
                <TextBlock Text="IF THIS HAPPENS, DO THAT — CHECKED EVERY FEW SECONDS" Style="{StaticResource Text.Label}" Margin="0,6,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ============================================================ rules as sentences -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource VoltLineBrush}" BorderThickness="0,0,0,2" Padding="0,18">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                            <Setter Property="Opacity" Value="0.4"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" Margin="0,0,18,0" ToolTip="Armed"/>
                                    <Button Style="{StaticResource Btn.Outline}" Content="EDIT" Margin="0,0,8,0" Padding="16,8"
                                            Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource Btn.Ghost}" Content="&#xE74D;" FontFamily="{StaticResource Glyphs}" FontWeight="Normal" ToolTip="Delete"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                </StackPanel>
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="WHEN " Style="{StaticResource Text.H2}" Opacity="0.4"/>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.H2}"/>
                                    <TextBlock Text=" · " Style="{StaticResource Text.H2}" Opacity="0.4"/>
                                    <TextBlock Text="{Binding Condition}" Style="{StaticResource Text.H2}"/>
                                    <TextBlock Text=" · " Style="{StaticResource Text.H2}" Opacity="0.4"/>
                                    <TextBlock Text="{Binding Sustain}" Style="{StaticResource Text.H2}"/>
                                    <TextBlock Text="  →  " Style="{StaticResource Text.H2}" Opacity="0.4"/>
                                    <Border Background="{StaticResource VoltBrush}" Padding="10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Response}" Style="{StaticResource Text.H2}" Foreground="{StaticResource InkBrush}"/>
                                    </Border>
                                </WrapPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,80">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsLoaded}" Value="True"/>
                                <Condition Binding="{Binding Rules.Count}" Value="0"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="NOTHING&#x0a;IS BEING&#x0a;WATCHED." Style="{StaticResource Text.Hero}" FontSize="110" LineHeight="96" Opacity="0.2"/>
            <TextBlock Style="{StaticResource Text.Body}" FontSize="16" MaxWidth="480" HorizontalAlignment="Left" Margin="0,22,0,0" Opacity="0.75"
                       Text="Tell ProGuard what to do when a program misbehaves: drop a CPU hog to idle once it's been pinning the machine for 30 seconds, end a memory leak at 4 GB, or just log it."/>
        </StackPanel>

        <!-- ============================================================ sentence builder -->
        <Border Grid.Column="1" Grid.Row="1" Width="400" Margin="32,0,0,0" BorderBrush="{StaticResource VoltBrush}" BorderThickness="2"
                Visibility="{Binding Editor, Converter={StaticResource VisibleWhen}}">
            <DockPanel DataContext="{Binding Editor}">
                <Border DockPanel.Dock="Top" Background="{StaticResource VoltBrush}" Padding="20,14">
                    <TextBlock Text="{Binding Heading}" Foreground="{StaticResource InkBrush}" FontWeight="Bold" FontStretch="Condensed" FontSize="26"/>
                </Border>
                <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="20,0,20,20">
                    <Button Style="{StaticResource Btn.Ghost}" Content="CANCEL" Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <Button Style="{StaticResource Btn.Solid}" Content="SAVE WATCH" Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                </UniformGrid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,18,20,18">
                        <TextBlock Text="WHEN" Style="{StaticResource Text.H2}" FontSize="18" Opacity="0.4"/>
                        <TextBox Style="{StaticResource Field}" Tag="e.g. chrome.exe" Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}" FontSize="20" FontWeight="Bold"/>

                        <TextBlock Text="IS" Style="{StaticResource Text.H2}" FontSize="18" Opacity="0.4" Margin="0,16,0,6"/>
                        <ListBox Style="{StaticResource Choices}" ItemsSource="{Binding Triggers}" SelectedItem="{Binding Trigger}"/>

                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Unit}" Style="{StaticResource Text.H2}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBox Style="{StaticResource Field}" Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Mono}"
                                     FontSize="24" FontWeight="Bold"/>
                        </DockPanel>

                        <TextBlock Text="HOW LONG" Style="{StaticResource Text.H2}" FontSize="18" Opacity="0.4" Margin="0,16,0,6"/>
                        <ListBox Style="{StaticResource Choices}" ItemsSource="{Binding Sustains}" SelectedItem="{Binding Sustain}"/>

                        <TextBlock Text="THEN" Style="{StaticResource Text.H2}" FontSize="18" Opacity="0.4" Margin="0,10,0,6"/>
                        <ListBox Style="{StaticResource Choices}" ItemsSource="{Binding Responses}" SelectedItem="{Binding Response}"/>

                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" Margin="0,16,0,0">
                            <TextBlock Text="ARMED" FontWeight="Bold" FontSize="14"/>
                        </CheckBox>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
